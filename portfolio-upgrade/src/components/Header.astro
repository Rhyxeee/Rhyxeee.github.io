---
// Header.astro — Glassmorphism nav with active section tracking + mobile menu
---

<header id="site-header" class="site-header">
  <nav class="nav-inner">
    <!-- Logo -->
    <a href="#top" class="nav-logo" aria-label="Mark Anthony Nene home">
      <span class="logo-monogram">MN</span>
      <span class="logo-name">Mark Anthony Nene</span>
    </a>

    <!-- Desktop links -->
    <ul class="nav-links" role="list">
      <li><a href="#about"      class="nav-link" data-section="about">About</a></li>
      <li><a href="#experience" class="nav-link" data-section="experience">Experience</a></li>
      <li><a href="#projects"   class="nav-link" data-section="projects">Projects</a></li>
      <li><a href="#contact"    class="nav-link nav-link--cta" data-section="contact">Let's Talk</a></li>
    </ul>

    <!-- Mobile hamburger -->
    <button class="burger" id="burger-btn" aria-label="Toggle menu" aria-expanded="false">
      <span class="burger-bar"></span>
      <span class="burger-bar"></span>
      <span class="burger-bar"></span>
    </button>
  </nav>

  <!-- Mobile drawer -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <ul role="list">
      <li><a href="#about"      class="mobile-link" data-mobile-section="about">About</a></li>
      <li><a href="#experience" class="mobile-link" data-mobile-section="experience">Experience</a></li>
      <li><a href="#projects"   class="mobile-link" data-mobile-section="projects">Projects</a></li>
      <li><a href="#contact"    class="mobile-link">Let's Talk</a></li>
    </ul>
  </div>
</header>

<style>
  /* ---------- Base ---------- */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    transition: background 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
    border-bottom: 1px solid transparent;
  }

  /* Scrolled state — applied via JS */
  .site-header.scrolled {
    background: rgba(10, 15, 28, 0.72);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    border-bottom-color: rgba(56, 189, 248, 0.10);
    box-shadow: 0 1px 32px rgba(0, 0, 0, 0.45);
  }

  /* ---------- Inner ---------- */
  .nav-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* ---------- Logo ---------- */
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-monogram {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.30);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 600;
    color: #38bdf8;
    letter-spacing: 0.04em;
    transition: background 0.2s, box-shadow 0.2s;
  }

  .nav-logo:hover .logo-monogram {
    background: rgba(56, 189, 248, 0.20);
    box-shadow: 0 0 14px rgba(56, 189, 248, 0.25);
  }

  .logo-name {
    font-size: 14px;
    font-weight: 500;
    color: #e2e8f0;
    letter-spacing: -0.01em;
  }

  /* ---------- Desktop nav links ---------- */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    position: relative;
    padding: 8px 14px;
    font-size: 13.5px;
    font-weight: 450;
    color: rgba(226, 232, 240, 0.60);
    text-decoration: none;
    border-radius: 8px;
    transition: color 0.2s, background 0.2s;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 4px;
    left: 50%;
    transform: translateX(-50%) scaleX(0);
    width: 16px;
    height: 1.5px;
    background: #38bdf8;
    border-radius: 99px;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .nav-link:hover,
  .nav-link.active {
    color: #e2e8f0;
  }

  .nav-link.active::after {
    transform: translateX(-50%) scaleX(1);
  }

  /* CTA button link */
  .nav-link--cta {
    margin-left: 8px;
    padding: 7px 18px;
    color: #38bdf8 !important;
    border: 1px solid rgba(56, 189, 248, 0.35);
    border-radius: 99px;
    font-weight: 500;
    transition: background 0.2s, border-color 0.2s, box-shadow 0.2s, color 0.2s;
  }

  .nav-link--cta::after { display: none; }

  .nav-link--cta:hover {
    background: rgba(56, 189, 248, 0.10);
    border-color: rgba(56, 189, 248, 0.60);
    box-shadow: 0 0 18px rgba(56, 189, 248, 0.20);
  }

  /* ---------- Burger ---------- */
  .burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 6px;
  }

  .burger-bar {
    width: 22px;
    height: 1.5px;
    background: #e2e8f0;
    border-radius: 99px;
    transition: transform 0.3s, opacity 0.3s, width 0.3s;
    display: block;
  }

  .burger.open .burger-bar:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .burger.open .burger-bar:nth-child(2) {
    opacity: 0;
    width: 0;
  }
  .burger.open .burger-bar:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  /* ---------- Mobile menu ---------- */
  .mobile-menu {
    display: none;
    background: rgba(10, 15, 28, 0.96);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(56, 189, 248, 0.10);
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .mobile-menu.open {
    max-height: 280px;
  }

  .mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 0.75rem 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .mobile-link {
    display: block;
    padding: 12px 14px;
    font-size: 15px;
    font-weight: 450;
    color: rgba(226, 232, 240, 0.70);
    text-decoration: none;
    border-radius: 8px;
    transition: color 0.2s, background 0.2s;
  }

  .mobile-link:hover,
  .mobile-link.active {
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.07);
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 700px) {
    .nav-links    { display: none; }
    .logo-name    { display: none; }
    .burger       { display: flex; }
    .mobile-menu  { display: block; }
  }
</style>

<script lang="ts">
  const header = document.getElementById('site-header') as HTMLElement | null;
  const burgerBtn = document.getElementById('burger-btn') as HTMLButtonElement | null;
  const mobileMenu = document.getElementById('mobile-menu') as HTMLElement | null;
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link[data-section]');
  const mobileLinks = document.querySelectorAll<HTMLAnchorElement>('.mobile-link[data-mobile-section]');

  if (!header || !burgerBtn || !mobileMenu) {
    throw new Error('Header elements are missing from the DOM.');
  }

  const focusableSelector =
    'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';

  const openMenu = () => {
    mobileMenu.classList.add('open');
    burgerBtn.classList.add('open');
    burgerBtn.setAttribute('aria-expanded', 'true');
    mobileMenu.setAttribute('aria-hidden', 'false');

    const firstFocusable = mobileMenu.querySelector<HTMLElement>(focusableSelector);
    firstFocusable?.focus();
  };

  const closeMenu = () => {
    mobileMenu.classList.remove('open');
    burgerBtn.classList.remove('open');
    burgerBtn.setAttribute('aria-expanded', 'false');
    mobileMenu.setAttribute('aria-hidden', 'true');
    burgerBtn.focus();
  };

  const toggleMenu = () => {
    const isOpen = mobileMenu.classList.contains('open');
    if (isOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  };

  /* FIXED: glass header on scroll */
  const onScroll = () => {
    header.classList.toggle('scrolled', window.scrollY > 20);
  };

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  /* FIXED: proper menu toggle */
  burgerBtn.addEventListener('click', toggleMenu);

  /* FIXED: close menu on link click */
  mobileMenu.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  /* FIXED: close on Escape */
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && mobileMenu.classList.contains('open')) {
      closeMenu();
    }
  });

  /* FIXED: close when clicking outside */
  document.addEventListener('click', (event) => {
    const target = event.target as Node;
    const clickedInsideMenu = mobileMenu.contains(target);
    const clickedBurger = burgerBtn.contains(target);

    if (
      mobileMenu.classList.contains('open') &&
      !clickedInsideMenu &&
      !clickedBurger
    ) {
      closeMenu();
    }
  });

  /* Active section tracking */
  const sections = ['about', 'experience', 'projects', 'contact'];

  const setActive = (id: string) => {
    navLinks.forEach((link) => {
      link.classList.toggle('active', link.dataset.section === id);
    });

    mobileLinks.forEach((link) => {
      link.classList.toggle('active', link.dataset.mobileSection === id);
    });
  };

  const sectionObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          setActive(entry.target.id);
        }
      });
    },
    { rootMargin: '-40% 0px -55% 0px' }
  );

  sections.forEach((id) => {
    const sectionEl = document.getElementById(id);
    if (sectionEl) sectionObserver.observe(sectionEl);
  });
</script>
