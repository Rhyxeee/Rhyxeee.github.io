---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroHome from '../components/HeroHome.astro';
import TechStackMarquee from '../components/TechStackMarquee.astro';
import ProjectCard from '../components/ProjectCard.astro';
import QuickPreviewCard from '../components/QuickPreviewCard.astro';
import { site, proofCards, achievements, experienceRows } from '../data/site';
import { projects } from '../data/portfolio';

const featuredProjects = projects.slice(0, 3);
const featuredProof = proofCards.slice(0, 3);
---

<BaseLayout title={`${site.name} · ${site.title}`} description={site.description} currentPath="/">
  <HeroHome />
  <TechStackMarquee />

  <section class="container page-shell" style="padding-top:1rem;">
    <div class="page-header">
      <span class="eyebrow">Featured projects</span>
      <h2 class="section-title">Projects built on clean data, clear systems, and practical reporting.</h2>
      <p class="lead">The home page only previews the best pieces. The full project library lives on its own page so people do not have to fight through one long scroll.</p>
    </div>
    <div class="grid-3">
      {featuredProjects.map((project) => (
        <ProjectCard {...project} href={`/projects/${project.slug}`} links={project.links} />
      ))}
    </div>
    <div class="spacer-2"></div>
    <a class="btn-ghost" href="/projects">Open all projects</a>
  </section>

  <section class="container page-shell" style="padding-top:2rem;">
    <div class="grid-2">
      <div>
        <div class="page-header">
          <span class="eyebrow">Why this structure</span>
          <h2 class="section-title">A home page for impact, not for endless scrolling.</h2>
          <p class="lead">This redesign moves the site closer to a cleaner analytics app. Home gives the overview. Other pages handle their own job properly.</p>
        </div>
        <div class="grid-3" style="grid-template-columns:1fr;">
          <QuickPreviewCard title="About" body="Your strengths, work style, experience, and process live on a dedicated page instead of getting buried below the fold." href="/about" accent="blue" />
          <QuickPreviewCard title="Proof" body="Achievements, capabilities, and trust-building signals are grouped together so credibility is easier to scan." href="/proof" accent="amber" />
          <QuickPreviewCard title="Contact" body="A shorter, cleaner page for email, links, resume access, and action-focused next steps." href="/contact" accent="green" />
        </div>
      </div>
      <div class="panel panel-pad-lg">
        <span class="eyebrow">Selected proof</span>
        <h3 style="margin:0 0 1rem; font-size:1.8rem; letter-spacing:-0.03em;">A cleaner way to show credibility.</h3>
        <div class="grid-3" style="grid-template-columns:1fr; gap:0.9rem;">
          {featuredProof.map((item) => (
            <div class="card" style="padding:1rem;">
              <strong>{item.title}</strong>
              <div class={`accent-${item.accent}`} style="margin-top:0.3rem; font-size:0.92rem;">{item.meta}</div>
              <p class="muted" style="margin:0.65rem 0 0;">{item.body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="container page-shell" style="padding-top:1rem;">
    <div class="grid-2">
      <div class="panel panel-pad-lg">
        <span class="eyebrow">Current work</span>
        <h3 style="margin:0 0 1rem; font-size:1.8rem; letter-spacing:-0.03em;">Experience preview</h3>
        <div class="card" style="padding:1rem;">
          <strong>{experienceRows[0].role}</strong>
          <div class="muted" style="margin-top:0.4rem;">{experienceRows[0].company} · {experienceRows[0].meta}</div>
          <p class="muted" style="margin:0.85rem 0 0;">{experienceRows[0].summary}</p>
        </div>
        <div class="spacer-1"></div>
        <a href="/about" class="btn-ghost">Open about and experience</a>
      </div>
      <div class="panel panel-pad-lg">
        <span class="eyebrow">Highlights</span>
        <h3 style="margin:0 0 1rem; font-size:1.8rem; letter-spacing:-0.03em;">Four quick proof points</h3>
        <ul class="list-clean" style="display:grid; gap:0.9rem;">
          {achievements.map((item) => (
            <li class="card" style="padding:1rem; color:var(--muted); line-height:1.8;">{item}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
