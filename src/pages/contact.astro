---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title={`Contact · ${site.name}`} description="Contact" currentPath="/contact">
  <section class="container page-shell">
    <div class="page-header">
      <span class="eyebrow">Contact</span>
      <h1 class="section-title">Need cleaner data, stronger reporting, or a workflow that holds up under review?</h1>
      <p class="lead">This page keeps the next step obvious. If the work needs structured cleanup, dashboard preparation, documentation, or analysis support, these are the fastest ways to reach me.</p>
    </div>

    <div class="grid-3 contact-grid">
      <div class="panel panel-pad-lg contact-card contact-card--blue">
        <h2>Email</h2>
        <p class="muted">Best for direct work inquiries, freelance conversations, and portfolio follow-ups.</p>
        <div class="spacer-1"></div>
        <a class="btn" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
      <div class="panel panel-pad-lg contact-card contact-card--green">
        <h2>GitHub</h2>
        <p class="muted">For source code, portfolio repositories, and implementation-heavy project review.</p>
        <div class="spacer-1"></div>
        <a class="btn-ghost" href="https://github.com/Rhyxeee" target="_blank" rel="noreferrer">Open GitHub</a>
      </div>
      <div class="panel panel-pad-lg contact-card contact-card--amber">
        <h2>Resume</h2>
        <p class="muted">Quick access for applications, recruiter review, and skills overview.</p>
        <div class="spacer-1"></div>
        <a class="btn-ghost" href={site.resumeUrl} target="_blank" rel="noreferrer">Download resume</a>
      </div>
    </div>
  </section>

<style>
  .contact-grid { align-items: stretch; }
  .contact-card h2 {
    margin: 0 0 0.85rem;
    font-size: 1.45rem;
    letter-spacing: -0.02em;
  }
  .contact-card--blue::before { background: linear-gradient(90deg, transparent, rgba(56,189,248,0.4), transparent); }
  .contact-card--green::before { background: linear-gradient(90deg, transparent, rgba(34,197,94,0.32), transparent); }
  .contact-card--amber::before { background: linear-gradient(90deg, transparent, rgba(245,158,11,0.32), transparent); }
</style>
