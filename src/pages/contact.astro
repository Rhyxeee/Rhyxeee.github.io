---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title={`Contact · ${site.name}`} description="Contact" currentPath="/contact">
  <section class="container page-shell">
    <div class="page-header">
      <span class="eyebrow">Contact</span>
      <h1 class="section-title">Need cleaner data, stronger reporting, or a more reliable workflow?</h1>
      <p class="lead">This page keeps the next step obvious. No endless scrolling. No extra clutter. Just the links people actually need when they are ready to reach out.</p>
    </div>

    <div class="grid-3">
      <div class="panel panel-pad-lg">
        <h2 style="margin:0 0 0.75rem; font-size:1.4rem;">Email</h2>
        <p class="muted">Best for direct work inquiries and portfolio conversations.</p>
        <div class="spacer-1"></div>
        <a class="btn" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
      <div class="panel panel-pad-lg">
        <h2 style="margin:0 0 0.75rem; font-size:1.4rem;">GitHub</h2>
        <p class="muted">Code, repositories, and portfolio source work.</p>
        <div class="spacer-1"></div>
        <a class="btn-ghost" href="https://github.com/Rhyxeee" target="_blank" rel="noreferrer">Open GitHub</a>
      </div>
      <div class="panel panel-pad-lg">
        <h2 style="margin:0 0 0.75rem; font-size:1.4rem;">Resume</h2>
        <p class="muted">Quick access for applications and recruiter review.</p>
        <div class="spacer-1"></div>
        <a class="btn-ghost" href={site.resumeUrl} target="_blank" rel="noreferrer">Download resume</a>
      </div>
    </div>
  </section>
</BaseLayout>
