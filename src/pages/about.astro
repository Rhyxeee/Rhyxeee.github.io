---
import BaseLayout from '../layouts/BaseLayout.astro';
import TechStackMarquee from '../components/TechStackMarquee.astro';
import { site, experienceRows, achievements } from '../data/site';
---

<BaseLayout title={`About · ${site.name}`} description="About and experience" currentPath="/about">
  <section class="container page-shell">
    <div class="page-header">
      <span class="eyebrow">About</span>
      <h1 class="section-title">Data-facing work built around structure, reviewability, and practical outputs.</h1>
      <p class="lead">I work best where raw records need discipline, teams need cleaner reporting, and the final output has to stand up to review instead of just looking impressive for one minute.</p>
    </div>

    <div class="grid-3 about-cluster">
      <div class="panel panel-pad-lg about-card">
        <span class="eyebrow">What I bring</span>
        <h2 class="about-title">Analytical work with cleaner handoff.</h2>
        <p class="muted">My focus is not just getting an answer. It is building a workflow other people can review, reuse, and trust after I leave the file.</p>
      </div>
      <div class="panel panel-pad-lg about-card">
        <span class="eyebrow">How I work</span>
        <ul class="list-clean about-list">
          <li class="card">Accuracy first</li>
          <li class="card">Repeatable workflow design</li>
          <li class="card">Clear documentation and reviewability</li>
          <li class="card">Business-ready reporting outputs</li>
        </ul>
      </div>
      <div class="panel panel-pad-lg about-card">
        <span class="eyebrow">Selected strengths</span>
        <ul class="list-clean about-list about-list-copy">
          {achievements.slice(0, 3).map((item) => (
            <li class="card">{item}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <TechStackMarquee />

  <section class="container page-shell" style="padding-top:1rem;">
    <div class="page-header">
      <span class="eyebrow">Experience</span>
      <h2 class="section-title">Experience in roles where clean records and reliable outputs matter.</h2>
      <p class="lead">The common thread across the work is structured handling of messy information, operational checking, and outputs built for real use instead of presentation alone.</p>
    </div>

    <div class="experience-stack">
      {experienceRows.map((item) => (
        <article class="panel panel-pad-lg experience-panel">
          <div class="grid-2 experience-grid" style="grid-template-columns:0.72fr 1fr;">
            <div>
              <span class="eyebrow" style="margin-bottom:0.8rem;">Role</span>
              <h3 class="experience-title">{item.role}</h3>
              <div class="accent-blue" style="margin-top:0.7rem;">{item.company}</div>
              <div class="muted" style="margin-top:0.35rem;">{item.meta}</div>
              <div class="spacer-1"></div>
              <a href={item.link.href} target="_blank" rel="noreferrer" class="btn-ghost">{item.link.label}</a>
            </div>
            <div>
              <p class="muted" style="margin-top:0;">{item.summary}</p>
              <ul class="list-clean experience-bullets">
                {item.bullets.map((bullet) => (
                  <li class="card">{bullet}</li>
                ))}
              </ul>
              <div class="experience-tags">
                {item.stack.map((tech) => (
                  <span class="tag">{tech}</span>
                ))}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .about-cluster { align-items: stretch; }
  .about-title {
    margin: 0 0 0.75rem;
    font-size: clamp(1.45rem, 2vw, 1.8rem);
    letter-spacing: -0.03em;
    line-height: 1.18;
  }
  .about-list { display: grid; gap: 0.8rem; }
  .about-list li { padding: 1rem; }
  .about-list-copy li { color: var(--muted); line-height: 1.72; }
  .experience-stack { display: grid; gap: 1.2rem; }
  .experience-title {
    margin: 0;
    font-size: clamp(1.45rem, 2vw, 1.85rem);
    letter-spacing: -0.03em;
  }
  .experience-bullets {
    display: grid;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .experience-bullets li {
    padding: 0.95rem 1rem;
    color: var(--muted);
    line-height: 1.75;
  }
  .experience-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1rem;
  }
  @media (max-width: 1024px) {
    .about-cluster { grid-template-columns: 1fr; }
  }
</style>
