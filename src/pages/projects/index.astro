---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { site } from '../../data/site';
import { projects } from '../../data/portfolio';
---

<BaseLayout title={`Projects · ${site.name}`} description="Project library" currentPath="/projects">
  <section class="container page-shell">
    <div class="page-header">
      <span class="eyebrow">Projects</span>
      <h1 class="section-title">Project pages built for faster scanning and stronger case-study reading.</h1>
      <p class="lead">Each card leads to a cleaner detail page that explains the business problem, the working method, and the outcome without forcing everything into one crowded screen.</p>
    </div>
    <div class="grid-3">
      {projects.map((project) => (
        <ProjectCard {...project} href={`/projects/${project.slug}`} links={project.links} />
      ))}
    </div>
  </section>
</BaseLayout>
