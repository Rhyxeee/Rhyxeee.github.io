---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { site } from '../../data/site';
import { projects } from '../../data/portfolio';
---

<BaseLayout title={`Projects · ${site.name}`} description="Project library" currentPath="/projects">
  <section class="container page-shell">
    <div class="page-header projects-header">
      <span class="eyebrow">Projects</span>
      <h1 class="section-title">Case-study style work, organized so people can scan quickly and open the right piece immediately.</h1>
      <p class="lead">This page is for the actual work: structured projects, dashboard-facing outputs, SQL analysis, and data-cleaning cases that are easier to review one by one.</p>
    </div>
    <div class="grid-3">
      {projects.map((project) => (
        <ProjectCard {...project} href={`/projects/${project.slug}`} links={project.links} />
      ))}
    </div>
  </section>
</BaseLayout>
