---
import { marqueeRows } from '../data/site';
const directions = ['normal', 'reverse', 'normal'];

const iconMap: Record<string, string> = {
  'Power BI': 'chart',
  'Excel': 'sheet',
  'Google Sheets': 'sheet',
  'SQL': 'database',
  'Python': 'code',
  'Data Cleaning': 'sparkles',
  'Reporting': 'report',
  'Audit Workflow': 'shield',
  'Dashboards': 'panel',
  'KPI Design': 'target',
  'JSON Parsing': 'braces',
  'ETL': 'arrows',
  'Documentation': 'file',
  'Automation': 'zap',
  'QA': 'check',
  'Business Analysis': 'briefcase',
  'Window Functions': 'sliders',
  'Forecasting': 'trend',
  'Data Validation': 'check',
  'Process Design': 'workflow',
  'Operational Accuracy': 'shield',
  'Skip Tracing': 'search',
  'Structured Systems': 'layers',
  'Decision Support': 'compass'
};

const icon = (name: string) => iconMap[name] ?? 'dot';
---

<section class="marquee-section">
  <div class="container">
    <div class="page-header marquee-intro">
      <span class="eyebrow">Toolbelt</span>
      <h2 class="section-title">A cleaner interface for the stack behind the work.</h2>
      <p class="lead">The goal is faster scanning and stronger visual memory. Each row carries the same quiet dashboard rhythm, just with better signal.</p>
    </div>

    <div class="marquee-shell panel panel-pad-lg">
      {marqueeRows.map((row, index) => {
        const doubled = [...row, ...row, ...row];
        return (
          <div class:list={["marquee-row", directions[index] === 'reverse' && 'is-reverse']}>
            <div class="marquee-track">
              {doubled.map((item) => (
                <span class="marquee-pill">
                  <span class="marquee-icon" data-icon={icon(item)} aria-hidden="true">
                    {
                      icon(item) === 'sheet' ? <svg viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6z" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M14 3v5h5" fill="none" stroke="currentColor" stroke-width="1.8"/></svg> :
                      icon(item) === 'database' ? <svg viewBox="0 0 24 24"><ellipse cx="12" cy="6" rx="7" ry="3" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M5 6v12c0 1.7 3.1 3 7 3s7-1.3 7-3V6" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M5 12c0 1.7 3.1 3 7 3s7-1.3 7-3" fill="none" stroke="currentColor" stroke-width="1.8"/></svg> :
                      icon(item) === 'code' ? <svg viewBox="0 0 24 24"><path d="M8 8 4 12l4 4M16 8l4 4-4 4M14 5l-4 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg> :
                      icon(item) === 'sparkles' ? <svg viewBox="0 0 24 24"><path d="m12 3 1.4 3.6L17 8l-3.6 1.4L12 13l-1.4-3.6L7 8l3.6-1.4ZM5 15l.8 2.2L8 18l-2.2.8L5 21l-.8-2.2L2 18l2.2-.8ZM18 14l1 2.5L21.5 18 19 19l-1 2.5L17 19l-2.5-1.5L17 16.5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg> :
                      icon(item) === 'report' ? <svg viewBox="0 0 24 24"><path d="M7 4h10v16H7z" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M10 9h4M10 13h4M10 17h3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg> :
                      icon(item) === 'shield' ? <svg viewBox="0 0 24 24"><path d="M12 3 5 6v6c0 5 3.3 7.9 7 9 3.7-1.1 7-4 7-9V6z" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m9.5 12 1.8 1.8L15.5 9.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg> :
                      icon(item) === 'panel' ? <svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M9 5v14M14 12h6" fill="none" stroke="currentColor" stroke-width="1.8"/></svg> :
                      icon(item) === 'target' ? <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="7" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 2v3M22 12h-3M12 22v-3M2 12h3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg> :
                      icon(item) === 'braces' ? <svg viewBox="0 0 24 24"><path d="M9 4c-2 0-3 1.5-3 3.5V10c0 1.1-.4 2-1.5 2 1.1 0 1.5.9 1.5 2v2.5C6 18.5 7 20 9 20M15 4c2 0 3 1.5 3 3.5V10c0 1.1.4 2 1.5 2-1.1 0-1.5.9-1.5 2v2.5c0 2-1 3.5-3 3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg> :
                      icon(item) === 'arrows' ? <svg viewBox="0 0 24 24"><path d="M4 7h11M11 3l4 4-4 4M20 17H9M13 13l-4 4 4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg> :
                      icon(item) === 'file' ? <svg viewBox="0 0 24 24"><path d="M7 3h7l5 5v13H7z" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M14 3v5h5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M10 13h6M10 17h4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg> :
                      icon(item) === 'zap' ? <svg viewBox="0 0 24 24"><path d="m13 2-8 11h6l-1 9 9-12h-6z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg> :
                      icon(item) === 'check' ? <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m8.5 12.5 2.3 2.3 4.9-5.1" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg> :
                      icon(item) === 'briefcase' ? <svg viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7M3 12h18" fill="none" stroke="currentColor" stroke-width="1.8"/></svg> :
                      icon(item) === 'sliders' ? <svg viewBox="0 0 24 24"><path d="M5 7h14M5 17h14M9 7v10M15 7v10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg> :
                      icon(item) === 'trend' ? <svg viewBox="0 0 24 24"><path d="M4 16l5-5 4 4 7-8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M15 7h5v5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg> :
                      icon(item) === 'workflow' ? <svg viewBox="0 0 24 24"><circle cx="6" cy="6" r="2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="18" cy="6" r="2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="6" cy="18" r="2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M8 6h8M6 8v8M8 18h10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg> :
                      icon(item) === 'layers' ? <svg viewBox="0 0 24 24"><path d="m12 5 8 4-8 4-8-4 8-4ZM4 14l8 4 8-4M4 18l8 4 8-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg> :
                      icon(item) === 'compass' ? <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m10 10 5-2-2 5-5 2z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg> :
                      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3" fill="currentColor"/></svg>
                    }
                  </span>
                  <span>{item}</span>
                </span>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .marquee-section { padding: 1rem 0 4.6rem; }
  .marquee-intro { margin-bottom: 1.8rem; }
  .marquee-shell { display: grid; gap: 1.05rem; overflow: hidden; }
  .marquee-row {
    overflow: hidden;
    border-radius: 20px;
    background: linear-gradient(180deg, rgba(5,10,21,0.68), rgba(7,12,24,0.46));
    border: 1px solid rgba(255,255,255,0.04);
    position: relative;
  }
  .marquee-row::before,
  .marquee-row::after {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 72px;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(90deg, rgba(8, 14, 28, 0.98), transparent);
  }
  .marquee-row::after {
    inset: 0 0 0 auto;
    background: linear-gradient(270deg, rgba(8, 14, 28, 0.98), transparent);
  }
  .marquee-track {
    display: flex;
    width: max-content;
    gap: 0.85rem;
    padding: 1.05rem 0.95rem;
    animation: marquee-left 32s linear infinite;
  }
  .marquee-row.is-reverse .marquee-track { animation-name: marquee-right; }
  .marquee-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.74rem 1rem;
    border-radius: 999px;
    background: rgba(15,23,42,0.88);
    border: 1px solid rgba(56,189,248,0.15);
    color: rgba(226,232,240,0.92);
    font-size: 0.95rem;
    white-space: nowrap;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.03);
  }
  .marquee-icon {
    width: 16px;
    height: 16px;
    color: var(--blue);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }
  .marquee-icon svg { width: 16px; height: 16px; }
  @keyframes marquee-left {
    from { transform: translateX(0); }
    to { transform: translateX(-33.333%); }
  }
  @keyframes marquee-right {
    from { transform: translateX(-33.333%); }
    to { transform: translateX(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; }
  }
</style>
