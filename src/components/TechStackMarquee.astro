---
import { marqueeRows } from '../data/site';
const directions = ['normal', 'reverse', 'normal'];
---

<section class="marquee-section">
  <div class="container">
    <div class="page-header">
      <span class="eyebrow">Toolbelt</span>
      <h2 class="section-title">A cleaner interface for the stack behind the work.</h2>
      <p class="lead">This replaces long tool lists with faster scanning. One row moves left, the next moves right, then the third returns left.</p>
    </div>

    <div class="marquee-shell panel panel-pad-lg">
      {marqueeRows.map((row, index) => {
        const doubled = [...row, ...row, ...row];
        return (
          <div class:list={["marquee-row", directions[index] === 'reverse' && 'is-reverse']}>
            <div class="marquee-track">
              {doubled.map((item) => (
                <span class="marquee-pill">{item}</span>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .marquee-section { padding: 1rem 0 4rem; }
  .marquee-shell { display: grid; gap: 1rem; overflow: hidden; }
  .marquee-row { overflow: hidden; border-radius: 18px; background: rgba(6,10,20,0.45); border: 1px solid rgba(255,255,255,0.04); }
  .marquee-track {
    display: flex;
    width: max-content;
    gap: 0.8rem;
    padding: 0.95rem 0.9rem;
    animation: marquee-left 30s linear infinite;
  }
  .marquee-row.is-reverse .marquee-track { animation-name: marquee-right; }
  .marquee-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.68rem 1rem;
    border-radius: 999px;
    background: rgba(15,23,42,0.88);
    border: 1px solid rgba(56,189,248,0.15);
    color: rgba(226,232,240,0.9);
    font-size: 0.95rem;
    white-space: nowrap;
  }
  @keyframes marquee-left {
    from { transform: translateX(0); }
    to { transform: translateX(-33.333%); }
  }
  @keyframes marquee-right {
    from { transform: translateX(-33.333%); }
    to { transform: translateX(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; }
  }
</style>
