const accentClasses = {
  blue: 'is-blue',
  amber: 'is-amber',
  green: 'is-green',
  purple: 'is-purple'
};

const fallback = { accent: 'blue', svg: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5v14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>` };
---

<section class="marquee-section">
  <div class="container">
    <div class="page-header toolbelt-intro">
      <span class="eyebrow">Toolbelt</span>
      <h2 class="section-title">Core tools and systems behind the work.</h2>
      <p class="lead">The stack is grouped here so recruiters and clients can scan it quickly without digging through long paragraphs.</p>
    </div>

    <div class="marquee-shell panel panel-pad-lg">
      {marqueeRows.map((row, index) => {
        const doubled = [...row, ...row, ...row];
        return (
          <div class:list={["marquee-row", directions[index] === 'reverse' && 'is-reverse']}>
            <div class="marquee-track">
              {doubled.map((item) => {
                const icon = iconMap[item] ?? fallback;
                return (
                  <span class:list={["marquee-pill", accentClasses[icon.accent]]}>
                    <span class="marquee-icon" set:html={icon.svg}></span>
                    <span>{item}</span>
                  </span>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .marquee-section { padding: 0.5rem 0 4rem; }
  .toolbelt-intro { margin-bottom: 1.7rem; }
  .marquee-shell { display: grid; gap: 1rem; overflow: hidden; }
  .marquee-shell::after,
  .marquee-shell::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 54px;
    z-index: 2;
    pointer-events: none;
  }
  .marquee-shell::before {
    left: 0;
    background: linear-gradient(90deg, var(--panel-strong), transparent);
  }
  .marquee-shell::after {
    right: 0;
    background: linear-gradient(270deg, var(--panel-strong), transparent);
  }
  .marquee-row {
    overflow: hidden;
    border-radius: 18px;
    background: var(--hover-soft);
    border: 1px solid var(--border-soft);
  }
  .marquee-track {
    display: flex;
    width: max-content;
    gap: 0.8rem;
    padding: 0.95rem 0.9rem;
    animation: marquee-left 34s linear infinite;
  }
  .marquee-row.is-reverse .marquee-track { animation-name: marquee-right; }
  .marquee-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.68rem 1rem;
    border-radius: 999px;
    background: rgba(15,23,42,0.88);
    border: 1px solid rgba(255,255,255,0.08);
    color: rgba(226,232,240,0.9);
    font-size: 0.95rem;
    white-space: nowrap;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.03);
  }
  .marquee-icon {
    width: 18px;
    height: 18px;
    display: inline-flex;
    color: inherit;
    opacity: 0.95;
  }
  .marquee-icon :global(svg) {
    width: 18px;
    height: 18px;
    display: block;
  }
  .marquee-pill.is-blue { color: #8bdcff; border-color: rgba(56,189,248,0.16); }
  .marquee-pill.is-amber { color: #f8cf6b; border-color: rgba(245,158,11,0.16); }
  .marquee-pill.is-green { color: #7ee1a0; border-color: rgba(34,197,94,0.16); }
  .marquee-pill.is-purple { color: #c792ff; border-color: rgba(168,85,247,0.16); }
  @keyframes marquee-left {
    from { transform: translateX(0); }
    to { transform: translateX(-33.333%); }
  }
  @keyframes marquee-right {
    from { transform: translateX(-33.333%); }
    to { transform: translateX(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; }
  }
</style>
