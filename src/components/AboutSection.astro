---
import { achievements, skills } from "../data/site";
---

<section id="about" class="about-section">
  <div class="about-shell">
    <div class="about-intro" data-animate="fade-up">
      <span class="section-eyebrow">About</span>
      <h2 class="section-title">A portfolio designed like a system, not just a gallery.</h2>
      <p class="section-sub">
        Many portfolio sites stop at visuals. This one is structured to communicate how I think
        through messy data, accuracy problems, documentation, and practical reporting.
      </p>
    </div>

    <div class="about-grid">
      <article class="about-panel about-panel--large" data-animate="fade-up" data-delay="80">
        <div class="panel-head">
          <h3>Selected achievements</h3>
          <p>Proof that the work goes beyond presentation and into usable outputs.</p>
        </div>

        <div class="achievement-list">
          {achievements.map((item, index) => (
            <div class="achievement-card" style={`--delay:${index * 80}ms`}>
              <span class="achievement-index">0{index + 1}</span>
              <p>{item}</p>
            </div>
          ))}
        </div>
      </article>

      <div class="about-side">
        <article class="about-panel" data-animate="fade-left" data-delay="140">
          <div class="panel-head">
            <h3>Core stack</h3>
            <p>Tools and methods I use to turn messy inputs into decision-ready work.</p>
          </div>

          <div class="skill-cloud">
            {skills.map((skill) => (
              <span class="skill-pill">{skill}</span>
            ))}
          </div>
        </article>

        <article class="about-panel" data-animate="fade-left" data-delay="220">
          <div class="panel-head">
            <h3>Value I bring</h3>
            <p>The kind of contribution I focus on when the work needs to be trusted.</p>
          </div>

          <ul class="value-list">
            <li>Turn unstructured records into usable analysis inputs</li>
            <li>Document logic so work stays easy to verify and maintain</li>
            <li>Design outputs for decision makers, not only for analysts</li>
          </ul>
        </article>
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    position: relative;
    padding: 7rem 1.5rem;
  }

  .about-shell {
    max-width: 1100px;
    margin: 0 auto;
  }

  .about-intro {
    max-width: 760px;
    margin-bottom: 3rem;
  }

  .section-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #38bdf8;
    margin-bottom: 1rem;
  }

  .section-eyebrow::before {
    content: "";
    width: 26px;
    height: 1px;
    background: rgba(56, 189, 248, 0.75);
    display: inline-block;
  }

  .section-title {
    font-size: clamp(30px, 4vw, 46px);
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: #f8fafc;
    margin: 0 0 1rem;
    font-weight: 650;
    max-width: 760px;
  }

  .section-sub {
    margin: 0;
    max-width: 720px;
    font-size: 17px;
    line-height: 1.8;
    color: rgba(226, 232, 240, 0.68);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 1.5rem;
  }

  .about-side {
    display: grid;
    gap: 1.5rem;
  }

  .about-panel {
    position: relative;
    border-radius: 24px;
    background:
      linear-gradient(180deg, rgba(17, 24, 39, 0.86), rgba(10, 15, 28, 0.96));
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow:
      0 20px 60px rgba(0, 0, 0, 0.25),
      inset 0 1px 0 rgba(255, 255, 255, 0.03);
    padding: 1.75rem;
    overflow: hidden;
  }

  .about-panel::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(56, 189, 248, 0.32),
      transparent
    );
  }

  .panel-head h3 {
    margin: 0;
    color: #f8fafc;
    font-size: 1.25rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .panel-head p {
    margin: 0.7rem 0 0;
    color: rgba(226, 232, 240, 0.54);
    font-size: 14px;
    line-height: 1.7;
  }

  .achievement-list {
    display: grid;
    gap: 0.95rem;
    margin-top: 1.5rem;
  }

  .achievement-card {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 1rem;
    align-items: start;
    padding: 1rem 1rem 1rem 0.95rem;
    border-radius: 18px;
    background: rgba(2, 6, 23, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: transform 0.22s ease, border-color 0.22s ease, background 0.22s ease;
  }

  .achievement-card:hover {
    transform: translateY(-2px);
    border-color: rgba(56, 189, 248, 0.26);
    background: rgba(2, 6, 23, 0.9);
  }

  .achievement-index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    height: 44px;
    border-radius: 14px;
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.26);
    color: #38bdf8;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .achievement-card p {
    margin: 0;
    color: rgba(226, 232, 240, 0.8);
    font-size: 15px;
    line-height: 1.8;
  }

  .skill-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.35rem;
  }

  .skill-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.62rem 0.92rem;
    border-radius: 999px;
    background: rgba(15, 23, 42, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: rgba(226, 232, 240, 0.86);
    font-size: 13.5px;
    font-weight: 500;
    line-height: 1;
    transition: transform 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .skill-pill:hover {
    transform: translateY(-2px);
    color: #f8fafc;
    border-color: rgba(56, 189, 248, 0.3);
  }

  .value-list {
    list-style: none;
    margin: 1.3rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  .value-list li {
    position: relative;
    padding: 0.95rem 1rem 0.95rem 2.8rem;
    border-radius: 18px;
    background: rgba(2, 6, 23, 0.68);
    border: 1px solid rgba(255, 255, 255, 0.06);
    color: rgba(226, 232, 240, 0.82);
    font-size: 15px;
    line-height: 1.7;
  }

  .value-list li::before {
    content: "";
    position: absolute;
    left: 1rem;
    top: 1.15rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #38bdf8;
    box-shadow: 0 0 16px rgba(56, 189, 248, 0.45);
  }

  @media (max-width: 960px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .about-section {
      padding: 5.5rem 1rem;
    }

    .about-panel {
      padding: 1.25rem;
      border-radius: 20px;
    }

    .achievement-card {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }

    .achievement-index {
      width: fit-content;
    }
  }
</style>
