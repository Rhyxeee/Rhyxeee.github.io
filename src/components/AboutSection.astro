---
import { achievements } from '../data/site';
---
<section id="about" class="about-section">
  <div class="about-shell">
    <div class="about-intro" data-animate="fade-up">
      <span class="section-eyebrow">About</span>
      <h2 class="section-title">A portfolio designed like a system, not just a gallery.</h2>
      <p class="section-sub">
        This site is built to communicate how I approach messy data, quality checks,
        documentation, and decision-ready reporting in a cleaner, more product-like format.
      </p>
    </div>

    <div class="about-grid">
      <article class="about-panel about-panel--primary" data-animate="fade-up" data-delay="80">
        <div class="panel-head">
          <h3>Selected achievements</h3>
          <p>Concrete examples that show the work is practical, analytical, and usable.</p>
        </div>

        <div class="achievement-list">
          {achievements.map((item, index) => (
            <div class="achievement-card">
              <span class="achievement-index">0{index + 1}</span>
              <p>{item}</p>
            </div>
          ))}
        </div>
      </article>

      <article class="about-panel about-panel--secondary" data-animate="fade-left" data-delay="140">
        <div class="panel-head">
          <h3>How I work</h3>
          <p>Less clutter, stronger structure, and outputs that are easier to trust.</p>
        </div>

        <ul class="value-list">
          <li>Turn unstructured records into usable analysis inputs</li>
          <li>Document logic so work stays easy to verify and maintain</li>
          <li>Design outputs for decision makers, not only for analysts</li>
          <li>Prioritize repeatable workflows over one-off fixes</li>
        </ul>
      </article>
    </div>
  </div>
</section>

<style>
  .about-section { padding: 6.5rem 1.5rem 2rem; }
  .about-shell { max-width: 1100px; margin: 0 auto; }
  .about-intro { max-width: 760px; margin-bottom: 2.5rem; }
  .section-eyebrow { display:inline-flex; align-items:center; gap:.5rem; font-size:12px; font-weight:600; letter-spacing:.12em; text-transform:uppercase; color:#38bdf8; margin-bottom:1rem; }
  .section-eyebrow::before { content:""; width:26px; height:1px; background:rgba(56,189,248,.75); display:inline-block; }
  .section-title { margin:0 0 1rem; font-size:clamp(30px,4vw,46px); line-height:1.1; letter-spacing:-.03em; color:#f8fafc; font-weight:650; }
  .section-sub { margin:0; font-size:17px; line-height:1.8; color:rgba(226,232,240,.68); max-width:720px; }
  .about-grid { display:grid; grid-template-columns:1.15fr .85fr; gap:1.5rem; }
  .about-panel { position:relative; border-radius:24px; background:linear-gradient(180deg, rgba(17,24,39,.86), rgba(10,15,28,.96)); border:1px solid rgba(255,255,255,.08); box-shadow:0 20px 60px rgba(0,0,0,.25), inset 0 1px 0 rgba(255,255,255,.03); padding:1.75rem; overflow:hidden; }
  .about-panel::before { content:""; position:absolute; inset:0 0 auto 0; height:1px; background:linear-gradient(90deg, transparent, rgba(56,189,248,.32), transparent); }
  .panel-head h3 { margin:0; color:#f8fafc; font-size:1.25rem; font-weight:650; letter-spacing:-.02em; }
  .panel-head p { margin:.7rem 0 0; color:rgba(226,232,240,.54); font-size:14px; line-height:1.7; }
  .achievement-list { display:grid; gap:.95rem; margin-top:1.45rem; }
  .achievement-card { display:grid; grid-template-columns:44px 1fr; gap:1rem; align-items:start; padding:1rem .95rem; border-radius:18px; background:rgba(2,6,23,.7); border:1px solid rgba(255,255,255,.06); transition:transform .22s ease, border-color .22s ease, background .22s ease; }
  .achievement-card:hover { transform:translateY(-2px); border-color:rgba(56,189,248,.26); background:rgba(2,6,23,.9); }
  .achievement-index { display:inline-flex; align-items:center; justify-content:center; min-width:44px; height:44px; border-radius:14px; background:rgba(56,189,248,.1); border:1px solid rgba(56,189,248,.26); color:#38bdf8; font-size:13px; font-weight:700; letter-spacing:.08em; }
  .achievement-card p { margin:0; color:rgba(226,232,240,.8); font-size:15px; line-height:1.8; }
  .value-list { list-style:none; margin:1.3rem 0 0; padding:0; display:grid; gap:.85rem; }
  .value-list li { position:relative; padding:.95rem 1rem .95rem 2.8rem; border-radius:18px; background:rgba(2,6,23,.68); border:1px solid rgba(255,255,255,.06); color:rgba(226,232,240,.82); font-size:15px; line-height:1.7; }
  .value-list li::before { content:""; position:absolute; left:1rem; top:1.15rem; width:9px; height:9px; border-radius:50%; background:#38bdf8; box-shadow:0 0 16px rgba(56,189,248,.45); }
  @media (max-width: 960px) { .about-grid { grid-template-columns:1fr; } }
  @media (max-width: 640px) { .about-section { padding:5.5rem 1rem 1rem; } .about-panel { padding:1.25rem; border-radius:20px; } .achievement-card { grid-template-columns:1fr; } .achievement-index { width:fit-content; } }
</style>
