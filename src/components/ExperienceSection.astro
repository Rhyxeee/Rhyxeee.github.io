---
import { experienceRows } from '../data/site';
---
<section id="experience" class="experience-section">
  <div class="experience-shell">
    <div class="experience-intro" data-animate="fade-up">
      <span class="section-eyebrow">Experience</span>
      <h2 class="section-title">Work that depends on clean records and reliable outputs.</h2>
      <p class="section-sub">My experience is strongest where data quality, verification, and process discipline matter.</p>
    </div>

    <div class="experience-list">
      {experienceRows.map((item, index) => (
        <article class="experience-card" data-animate="fade-up" data-delay={String(index * 90)}>
          <div class="experience-meta">
            <span class="experience-kicker">Role</span>
            <h3>{item.role}</h3>
            <p class="company">{item.company}</p>
            <p class="meta">{item.meta}</p>
            <a href={item.link.href} target="_blank" rel="noreferrer" class="experience-link">{item.link.label}</a>
          </div>
          <div class="experience-body">
            <p class="summary">{item.summary}</p>
            <ul class="bullet-list">
              {item.bullets.map((bullet) => (<li>{bullet}</li>))}
            </ul>
            <div class="stack-list">
              {item.stack.map((tech) => (<span class="stack-pill">{tech}</span>))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .experience-section { position: relative; padding: 7rem 1.5rem; }
  .experience-shell { max-width: 1100px; margin: 0 auto; }
  .experience-intro { max-width: 760px; margin-bottom: 3rem; }
  .section-eyebrow { display:inline-flex; align-items:center; gap:.5rem; font-size:12px; font-weight:600; letter-spacing:.12em; text-transform:uppercase; color:#38bdf8; margin-bottom:1rem; }
  .section-eyebrow::before { content:""; width:26px; height:1px; background:rgba(56,189,248,.75); display:inline-block; }
  .section-title { font-size:clamp(30px,4vw,46px); line-height:1.1; letter-spacing:-.03em; color:#f8fafc; margin:0 0 1rem; font-weight:650; max-width:760px; }
  .section-sub { margin:0; max-width:720px; font-size:17px; line-height:1.8; color:rgba(226,232,240,.68); }
  .experience-list { display:grid; gap:1.5rem; }
  .experience-card { display:grid; grid-template-columns:.72fr 1fr; gap:2rem; padding:1.75rem; border-radius:24px; background:linear-gradient(180deg, rgba(17,24,39,.86), rgba(10,15,28,.96)); border:1px solid rgba(255,255,255,.08); box-shadow:0 20px 60px rgba(0,0,0,.25), inset 0 1px 0 rgba(255,255,255,.03); overflow:hidden; position:relative; }
  .experience-card::before { content:""; position:absolute; inset:0 0 auto 0; height:1px; background:linear-gradient(90deg, transparent, rgba(56,189,248,.32), transparent); }
  .experience-kicker { display:inline-flex; width:fit-content; font-size:11px; text-transform:uppercase; letter-spacing:.12em; color:rgba(56,189,248,.82); margin-bottom:.85rem; }
  .experience-meta h3 { margin:0; color:#f8fafc; font-size:clamp(22px,2.2vw,30px); line-height:1.15; letter-spacing:-.02em; font-weight:650; }
  .company { margin:.85rem 0 0; color:#7dd3fc; font-size:14px; font-weight:500; }
  .meta { margin:.45rem 0 0; color:rgba(226,232,240,.48); font-size:14px; line-height:1.7; }
  .experience-link { display:inline-flex; align-items:center; margin-top:1.2rem; color:#86efac; font-size:14px; font-weight:500; text-decoration:none; gap:.45rem; }
  .experience-link::after { content:'↗'; font-size:14px; }
  .experience-link:hover { color:#dcfce7; }
  .summary { margin:0; color:rgba(226,232,240,.8); font-size:15px; line-height:1.85; }
  .bullet-list { list-style:none; margin:1.25rem 0 0; padding:0; display:grid; gap:.85rem; }
  .bullet-list li { position:relative; padding:.95rem 1rem .95rem 2.8rem; border-radius:18px; background:rgba(2,6,23,.68); border:1px solid rgba(255,255,255,.06); color:rgba(226,232,240,.82); font-size:15px; line-height:1.7; }
  .bullet-list li::before { content:""; position:absolute; left:1rem; top:1.15rem; width:9px; height:9px; border-radius:50%; background:#38bdf8; box-shadow:0 0 16px rgba(56,189,248,.45); }
  .stack-list { display:flex; flex-wrap:wrap; gap:.7rem; margin-top:1.2rem; }
  .stack-pill { display:inline-flex; align-items:center; padding:.62rem .92rem; border-radius:999px; background:rgba(15,23,42,.78); border:1px solid rgba(255,255,255,.08); color:rgba(226,232,240,.86); font-size:13.5px; font-weight:500; line-height:1; transition:transform .2s ease, border-color .2s ease, color .2s ease; }
  .stack-pill:hover { transform:translateY(-2px); color:#f8fafc; border-color:rgba(56,189,248,.3); }
  @media (max-width: 920px) { .experience-card { grid-template-columns:1fr; gap:1.4rem; } }
  @media (max-width: 640px) { .experience-section { padding:5.5rem 1rem; } .experience-card { padding:1.25rem; border-radius:20px; } }
</style>
