---
interface Props {
  title: string;
  body: string;
  href: string;
  accent?: 'blue' | 'amber' | 'green' | 'purple';
}
const { title, body, href, accent = 'blue' } = Astro.props;
---

<a href={href} class={`quick-card quick-card--${accent}`}>
  <span class="quick-card__label">{title}</span>
  <p class="quick-card__body">{body}</p>
  <span class="quick-card__action">Open →</span>
</a>

<style>
  .quick-card {
    display: grid;
    gap: 0.9rem;
    padding: 1.35rem 1.3rem;
    border-radius: 22px;
    background: rgba(8, 13, 25, 0.72);
    border: 1px solid rgba(255,255,255,0.08);
    text-decoration: none;
    transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
  }
  .quick-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 48px rgba(0,0,0,0.22);
  }
  .quick-card--blue:hover { border-color: rgba(56,189,248,0.28); }
  .quick-card--amber:hover { border-color: rgba(245,158,11,0.28); }
  .quick-card--green:hover { border-color: rgba(34,197,94,0.28); }
  .quick-card--purple:hover { border-color: rgba(168,85,247,0.28); }
  .quick-card__label {
    font-size: 1.08rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }
  .quick-card__body {
    margin: 0;
    color: var(--muted);
    line-height: 1.8;
  }
  .quick-card__action {
    width: fit-content;
    color: var(--text);
    font-weight: 600;
  }
  .quick-card--blue .quick-card__action { color: var(--blue); }
  .quick-card--amber .quick-card__action { color: var(--amber); }
  .quick-card--green .quick-card__action { color: var(--green); }
  .quick-card--purple .quick-card__action { color: var(--purple); }
</style>
