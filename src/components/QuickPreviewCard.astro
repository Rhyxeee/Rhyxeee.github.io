---
interface Props {
  title: string;
  body: string;
  href: string;
  accent?: 'blue' | 'amber' | 'green' | 'purple';
  kicker?: string;
}
const { title, body, href, accent = 'blue', kicker = 'Explore' } = Astro.props;
const accentColor = {
  blue: 'var(--blue)', amber: 'var(--amber)', green: 'var(--green)', purple: 'var(--purple)'
}[accent];
---
<div class="preview-card card" style={`--accent:${accentColor};`}>
  <span class="preview-kicker">{kicker}</span>
  <h3>{title}</h3>
  <p>{body}</p>
  <a href={href}>Open →</a>
</div>

<style>
  .preview-card {
    padding: 1.15rem 1.15rem 1.05rem;
    border-left: 3px solid var(--accent);
    position: relative;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.02);
  }
  .preview-kicker {
    display: inline-flex;
    margin-bottom: 0.65rem;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--accent) 84%, #ffffff 16%);
  }
  .preview-card h3 { margin: 0 0 0.55rem; font-size: 1.08rem; }
  .preview-card p { margin: 0 0 1rem; color: var(--muted); line-height: 1.75; }
  .preview-card a { color: var(--accent); text-decoration: none; font-weight: 600; }
</style>
