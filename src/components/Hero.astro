---
// Hero.astro — Particle canvas background, typewriter headline, animated stats
---

<section id="top" class="hero">

  <!-- Canvas particle network — rendered by JS -->
  <canvas id="hero-canvas" class="hero-canvas" aria-hidden="true"></canvas>

  <!-- Radial glow overlays -->
  <div class="hero-glow hero-glow--1" aria-hidden="true"></div>
  <div class="hero-glow hero-glow--2" aria-hidden="true"></div>

  <div class="hero-inner">

    <!-- Left: content -->
    <div class="hero-content">

      <!-- Eyebrow label -->
      <div class="hero-eyebrow" data-animate="fade-up" data-delay="0">
        <span class="eyebrow-line" aria-hidden="true"></span>
        <span>Freelance Data Analyst</span>
        <span class="eyebrow-dot" aria-hidden="true"></span>
        <span class="eyebrow-status">Open to work</span>
      </div>

      <!-- Headline with typewriter phrase -->
      <h1 class="hero-headline" data-animate="fade-up" data-delay="80">
        I turn messy records into<br>
        <span class="headline-typed" id="typed-phrase">decision-ready systems.</span>
      </h1>

      <!-- Sub copy -->
      <p class="hero-sub" data-animate="fade-up" data-delay="160">
        I clean, audit, and structure business data so reports, dashboards,
        and workflows become reliable enough for real decisions.
      </p>

      <!-- CTAs -->
      <div class="hero-ctas" data-animate="fade-up" data-delay="240">
        <a href="#projects" class="cta-primary">
          View Projects
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2.5 7H11.5M7.5 3L11.5 7L7.5 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a
          href="https://drive.google.com/uc?export=download&id=1ACO5c7FdHgKfljXX8RD0ES_2o2T1r2Wi"
          class="cta-secondary"
          download
        >
          Download Resume
        </a>
      </div>

      <!-- Stats row -->
      <div class="hero-stats" data-animate="fade-up" data-delay="320">
        <div class="stat">
          <span class="stat-num" data-count="4400" data-suffix="+">0+</span>
          <span class="stat-label">records cleaned</span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="stat">
          <span class="stat-num" data-prefix="₱" data-count="2" data-suffix="M+">₱0M+</span>
          <span class="stat-label">budget audited</span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="stat">
          <span class="stat-num" data-prefix="$" data-count="5" data-suffix="M+">$0M+</span>
          <span class="stat-label">sales analyzed</span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="stat">
          <span class="stat-num" data-count="100" data-suffix="%">0%</span>
          <span class="stat-label">accuracy focus</span>
        </div>
      </div>
    </div>

    <!-- Right: profile image -->
    <div class="hero-image-wrap" data-animate="fade-left" data-delay="200">
      <div class="image-ring image-ring--outer" aria-hidden="true"></div>
      <div class="image-ring image-ring--inner" aria-hidden="true"></div>
      <div class="image-frame">
        <img
          src="/images/profile.png"
          alt="Mark Anthony Nene"
          class="hero-profile-img"
          width="280"
          height="280"
          loading="eager"
        />
      </div>
      <!-- Floating badge -->
      <div class="profile-badge" aria-hidden="true">
        <span class="badge-dot"></span>
        <span>Available for hire</span>
      </div>
    </div>

  </div>

  <!-- Scroll indicator -->
  <div class="scroll-indicator" aria-hidden="true">
    <div class="scroll-line"></div>
  </div>

</section>

<style>
  /* ---------- Section shell ---------- */
  .hero {
    position: relative;
    min-height: 100svh;
    background: #080e1a;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-top: 64px; /* header height */
  }

  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0.55;
  }

  /* Radial glows */
  .hero-glow {
    position: absolute;
    pointer-events: none;
    border-radius: 50%;
    filter: blur(90px);
  }
  .hero-glow--1 {
    width: 600px;
    height: 600px;
    top: -120px;
    left: -160px;
    background: radial-gradient(circle, rgba(56,189,248,0.09) 0%, transparent 70%);
  }
  .hero-glow--2 {
    width: 500px;
    height: 500px;
    bottom: -80px;
    right: -100px;
    background: radial-gradient(circle, rgba(99,102,241,0.07) 0%, transparent 70%);
  }

  /* ---------- Inner layout ---------- */
  .hero-inner {
    position: relative;
    z-index: 2;
    max-width: 1100px;
    width: 100%;
    margin: 0 auto;
    padding: 4rem 1.5rem 3rem;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4rem;
    align-items: center;
  }

  /* ---------- Eyebrow ---------- */
  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.10em;
    color: #38bdf8;
    margin-bottom: 1.25rem;
  }

  .eyebrow-line {
    display: block;
    width: 28px;
    height: 1px;
    background: #38bdf8;
    flex-shrink: 0;
  }

  .eyebrow-dot {
    width: 4px;
    height: 4px;
    background: rgba(56,189,248,0.45);
    border-radius: 50%;
    flex-shrink: 0;
  }

  .eyebrow-status {
    color: rgba(56,189,248,0.65);
    font-size: 11px;
  }

  /* ---------- Headline ---------- */
  .hero-headline {
    font-size: clamp(28px, 4.5vw, 52px);
    font-weight: 650;
    line-height: 1.12;
    color: #f1f5f9;
    margin: 0 0 1.25rem;
    letter-spacing: -0.025em;
  }

  .headline-typed {
    color: #38bdf8;
    border-right: 2.5px solid #38bdf8;
    padding-right: 3px;
    animation: blink-cursor 1.1s step-end infinite;
  }

  @keyframes blink-cursor {
    0%, 100% { border-color: #38bdf8; }
    50%       { border-color: transparent; }
  }

  /* ---------- Sub copy ---------- */
  .hero-sub {
    font-size: 16px;
    line-height: 1.65;
    color: rgba(226, 232, 240, 0.55);
    max-width: 500px;
    margin: 0 0 2rem;
  }

  /* ---------- CTAs ---------- */
  .hero-ctas {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .cta-primary,
  .cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 11px 24px;
    font-size: 14px;
    font-weight: 500;
    border-radius: 99px;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .cta-primary {
    background: #38bdf8;
    color: #080e1a;
    border: 1px solid transparent;
  }
  .cta-primary:hover {
    background: #7dd3fc;
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(56, 189, 248, 0.35);
  }
  .cta-primary:active { transform: translateY(0); }

  .cta-secondary {
    background: transparent;
    color: rgba(226, 232, 240, 0.80);
    border: 1px solid rgba(226, 232, 240, 0.18);
  }
  .cta-secondary:hover {
    border-color: rgba(226, 232, 240, 0.40);
    color: #f1f5f9;
    transform: translateY(-2px);
  }

  /* ---------- Stats row ---------- */
  .hero-stats {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .stat-num {
    font-size: 22px;
    font-weight: 650;
    color: #f1f5f9;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    font-size: 11px;
    color: rgba(226, 232, 240, 0.40);
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }

  .stat-divider {
    width: 1px;
    height: 32px;
    background: rgba(226, 232, 240, 0.10);
    flex-shrink: 0;
  }

  /* ---------- Profile image ---------- */
  .hero-image-wrap {
    position: relative;
    width: 280px;
    height: 280px;
    flex-shrink: 0;
  }

  .image-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(56, 189, 248, 0.18);
    animation: ring-pulse 4s ease-in-out infinite;
  }
  .image-ring--outer {
    inset: -18px;
    animation-delay: 0s;
  }
  .image-ring--inner {
    inset: -8px;
    border-color: rgba(56, 189, 248, 0.28);
    animation-delay: 2s;
  }

  @keyframes ring-pulse {
    0%, 100% { opacity: 0.5; transform: scale(1); }
    50%       { opacity: 1;   transform: scale(1.02); }
  }

  .image-frame {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid rgba(56, 189, 248, 0.30);
    background: #0f1828;
  }

  .hero-profile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  /* Floating badge */
  .profile-badge {
    position: absolute;
    bottom: 12px;
    right: -16px;
    display: flex;
    align-items: center;
    gap: 7px;
    background: rgba(10, 20, 35, 0.85);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(56, 189, 248, 0.25);
    border-radius: 99px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 500;
    color: rgba(226, 232, 240, 0.85);
    white-space: nowrap;
    animation: badge-float 3s ease-in-out infinite;
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    background: #22c55e;
    border-radius: 50%;
    box-shadow: 0 0 8px rgba(34, 197, 94, 0.7);
    animation: dot-pulse 2s ease-in-out infinite;
  }

  @keyframes badge-float {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-5px); }
  }
  @keyframes dot-pulse {
    0%, 100% { box-shadow: 0 0 8px rgba(34, 197, 94, 0.7); }
    50%       { box-shadow: 0 0 16px rgba(34, 197, 94, 1); }
  }

  /* ---------- Scroll indicator ---------- */
  .scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 2;
  }

  .scroll-line {
    width: 1px;
    height: 50px;
    background: linear-gradient(to bottom, rgba(56,189,248,0.6), transparent);
    animation: scroll-line-drop 2s ease-in-out infinite;
  }

  @keyframes scroll-line-drop {
    0%   { transform: scaleY(0); transform-origin: top; opacity: 0; }
    30%  { transform: scaleY(1); transform-origin: top; opacity: 1; }
    70%  { transform: scaleY(1); transform-origin: bottom; opacity: 1; }
    100% { transform: scaleY(0); transform-origin: bottom; opacity: 0; }
  }

  /* ---------- Entrance animations ---------- */
  [data-animate] {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.65s cubic-bezier(0.4, 0, 0.2, 1),
                transform 0.65s cubic-bezier(0.4, 0, 0.2, 1);
  }
  [data-animate="fade-left"] {
    transform: translateX(24px);
  }
  [data-animate].appeared {
    opacity: 1;
    transform: none;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
      padding: 3rem 1.25rem 2.5rem;
      gap: 2.5rem;
    }
    .hero-eyebrow   { justify-content: center; }
    .hero-sub       { margin-left: auto; margin-right: auto; }
    .hero-ctas      { justify-content: center; }
    .hero-stats     { justify-content: center; }
    .hero-image-wrap {
      margin: 0 auto;
      width: 220px;
      height: 220px;
      order: -1;
    }
    .profile-badge { right: 0; }
  }
</style>

<script lang="ts">
  /* ===================================================
     1. PARTICLE NETWORK CANVAS
  =================================================== */
  (() => {
    const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
    const heroSection = document.getElementById('top');

    if (!canvas || !heroSection) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (prefersReducedMotion.matches) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    type Particle = {
      x: number;
      y: number;
      vx: number;
      vy: number;
      r: number;
    };

    let width = 0;
    let height = 0;
    let animationId = 0;
    let running = false;
    let particles: Particle[] = [];

    const PARTICLE_COUNT = 55;
    const MAX_DISTANCE = 140;
    const COLOR = '56, 189, 248';

    const resizeCanvas = () => {
      width = canvas.offsetWidth;
      height = canvas.offsetHeight;
      canvas.width = width;
      canvas.height = height;
    };

    const createParticles = () => {
      particles = Array.from({ length: PARTICLE_COUNT }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.35,
        vy: (Math.random() - 0.5) * 0.35,
        r: Math.random() * 2 + 1,
      }));
    };

    const draw = () => {
      if (!running) return;

      ctx.clearRect(0, 0, width, height);

      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const dx = particles[i].x - particles[j].x;
          const dy = particles[i].y - particles[j].y;
          const distance = Math.sqrt(dx * dx + dy * dy);

          if (distance < MAX_DISTANCE) {
            ctx.beginPath();
            ctx.strokeStyle = `rgba(${COLOR}, ${(1 - distance / MAX_DISTANCE) * 0.22})`;
            ctx.lineWidth = 0.8;
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(particles[j].x, particles[j].y);
            ctx.stroke();
          }
        }
      }

      particles.forEach((particle) => {
        ctx.beginPath();
        ctx.arc(particle.x, particle.y, particle.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${COLOR}, 0.55)`;
        ctx.fill();

        particle.x += particle.vx;
        particle.y += particle.vy;

        if (particle.x < 0 || particle.x > width) particle.vx *= -1;
        if (particle.y < 0 || particle.y > height) particle.vy *= -1;
      });

      animationId = requestAnimationFrame(draw);
    };

    const start = () => {
      if (running) return;
      running = true;
      draw();
    };

    const stop = () => {
      running = false;
      cancelAnimationFrame(animationId);
    };

    const visibilityObserver = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting && !document.hidden) {
          start();
        } else {
          stop();
        }
      },
      { threshold: 0.05 }
    );

    const onVisibilityChange = () => {
      if (document.hidden) {
        stop();
      } else {
        const heroRect = heroSection.getBoundingClientRect();
        const isVisible = heroRect.bottom > 0 && heroRect.top < window.innerHeight;
        if (isVisible) start();
      }
    };

    resizeCanvas();
    createParticles();
    visibilityObserver.observe(heroSection);

    window.addEventListener('resize', resizeCanvas, { passive: true });
    document.addEventListener('visibilitychange', onVisibilityChange, { passive: true });
  })();

  /* ===================================================
     2. TYPEWRITER
     FIXED: Keep only the typewriter here.
     Do NOT animate [data-count] here because scrollAnimations.ts
     already handles all counters globally.
  =================================================== */
  (() => {
    const typedEl = document.getElementById('typed-phrase');
    if (!typedEl) return;

    const phrases = [
      'decision-ready systems.',
      'clean data pipelines.',
      'audit-ready reports.',
      'reliable dashboards.',
    ];

    let phraseIndex = 0;
    let charIndex = 0;
    let deleting = false;

    const tick = () => {
      const currentPhrase = phrases[phraseIndex];

      if (!deleting) {
        charIndex++;
        typedEl.textContent = currentPhrase.slice(0, charIndex);

        if (charIndex === currentPhrase.length) {
          deleting = true;
          setTimeout(tick, 2200);
          return;
        }

        setTimeout(tick, 55);
      } else {
        charIndex--;
        typedEl.textContent = currentPhrase.slice(0, charIndex);

        if (charIndex === 0) {
          deleting = false;
          phraseIndex = (phraseIndex + 1) % phrases.length;
          setTimeout(tick, 320);
          return;
        }

        setTimeout(tick, 28);
      }
    };

    setTimeout(tick, 1200);
  })();
</script>
