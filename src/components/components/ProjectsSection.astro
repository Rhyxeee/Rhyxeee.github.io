---
import ProjectCard from './ProjectCard.astro';
import { projects } from '../data/portfolio';
---
<section id="projects" class="projects-section">
  <div class="section-header" data-animate="fade-up">
    <span class="section-eyebrow">Featured Work</span>
    <h2 class="section-title">
      Projects built on<br />
      <span class="title-accent">clean data, clear systems.</span>
    </h2>
    <p class="section-sub">
      Case-study style project cards with stronger structure, cleaner visuals,
      and clearer proof of work.
    </p>
  </div>

  <div class="projects-grid" data-stagger-parent="90">
    {projects.map((project) => (
      <div data-animate="fade-up" class="card-wrapper">
        <ProjectCard {...project} />
      </div>
    ))}
  </div>
</section>

<style>
  .projects-section {
    padding: 7rem 1.5rem;
    max-width: 1100px;
    margin: 0 auto;
  }
  .section-header {
    margin-bottom: 3.5rem;
    max-width: 600px;
  }
  .section-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #38bdf8;
    margin-bottom: 1rem;
  }
  .section-eyebrow::before {
    content: "";
    width: 26px;
    height: 1px;
    background: rgba(56, 189, 248, 0.75);
    display: inline-block;
  }
  .section-title {
    margin: 0;
    font-size: clamp(30px, 4vw, 46px);
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: #f8fafc;
    font-weight: 650;
  }
  .title-accent { color: #38bdf8; }
  .section-sub {
    margin-top: 1rem;
    color: rgba(226, 232, 240, 0.62);
    font-size: 17px;
    line-height: 1.8;
    max-width: 620px;
  }
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .card-wrapper { min-width: 0; }
  @media (max-width: 900px) {
    .projects-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .projects-section { padding: 5.5rem 1rem; }
  }
</style>
