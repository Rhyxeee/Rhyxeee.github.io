---
// ProjectCard.astro — Premium card with lift, border glow, category accent + animated tags

interface Props {
  title: string;
  description: string;
  category: string;
  tags: string[];
  imageSrc: string;
  imageAlt: string;
  /** 'blue' | 'amber' | 'green' | 'purple' | 'coral' */
  accent?: string;
  primaryLink?: string;
  primaryLabel?: string;
  secondaryLink?: string;
  secondaryLabel?: string;
}

const {
  title,
  description,
  category,
  tags,
  imageSrc,
  imageAlt,
  accent = 'blue',
  primaryLink,
  primaryLabel = 'View project',
  secondaryLink,
  secondaryLabel,
} = Astro.props;

const accentVars: Record<string, { color: string; bg: string; border: string; glow: string }> = {
  blue:   { color: '#38bdf8', bg: 'rgba(56,189,248,0.10)',   border: 'rgba(56,189,248,0.35)',  glow: 'rgba(56,189,248,0.18)'  },
  amber:  { color: '#f59e0b', bg: 'rgba(245,158,11,0.10)',   border: 'rgba(245,158,11,0.35)',  glow: 'rgba(245,158,11,0.18)'  },
  green:  { color: '#22c55e', bg: 'rgba(34,197,94,0.10)',    border: 'rgba(34,197,94,0.35)',   glow: 'rgba(34,197,94,0.18)'   },
  purple: { color: '#a855f7', bg: 'rgba(168,85,247,0.10)',   border: 'rgba(168,85,247,0.35)',  glow: 'rgba(168,85,247,0.18)'  },
  coral:  { color: '#fb7185', bg: 'rgba(251,113,133,0.10)',  border: 'rgba(251,113,133,0.35)', glow: 'rgba(251,113,133,0.18)' },
};

const a = accentVars[accent] ?? accentVars.blue;
---

<article
  class="proj-card"
  style={`--accent:${a.color};--accent-bg:${a.bg};--accent-border:${a.border};--accent-glow:${a.glow};`}
>
  <!-- Image header -->
  <div class="card-image">
    <img src={imageSrc} alt={imageAlt} loading="lazy" width="560" height="280" />
    <div class="card-image-overlay" aria-hidden="true"></div>

    <!-- Category badge -->
    <span class="category-badge">{category}</span>

    <!-- Hover link overlay -->
    {primaryLink && (
      <a href={primaryLink} target="_blank" rel="noopener noreferrer" class="image-hover-link" aria-label={`Open ${title}`} tabindex="-1">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M4 10h12M10 4l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    )}
  </div>

  <!-- Body -->
  <div class="card-body">
    <h3 class="card-title">{title}</h3>
    <p class="card-desc">{description}</p>

    <!-- Tags -->
    <div class="card-tags" aria-label="Technologies used">
      {tags.map(tag => <span class="tag">{tag}</span>)}
    </div>
  </div>

  <!-- Footer links -->
  <div class="card-footer">
    {primaryLink && (
      <a href={primaryLink} target="_blank" rel="noopener noreferrer" class="card-link card-link--primary">
        {primaryLabel}
        <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
          <path d="M2 6.5h9M6.5 2l4.5 4.5L6.5 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    )}
    {secondaryLink && (
      <a href={secondaryLink} target="_blank" rel="noopener noreferrer" class="card-link card-link--secondary">
        {secondaryLabel}
      </a>
    )}
  </div>

  <!-- Glow border highlight (animated on hover) -->
  <div class="card-glow-border" aria-hidden="true"></div>
</article>

<style>
  .proj-card {
    position: relative;
    background: #0d1524;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition:
      transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
      border-color 0.3s ease,
      box-shadow 0.35s ease;
    will-change: transform;
  }

  .proj-card:hover {
    transform: translateY(-6px);
    border-color: var(--accent-border);
    box-shadow:
      0 20px 60px rgba(0, 0, 0, 0.45),
      0 0 0 1px var(--accent-border),
      0 0 40px var(--accent-glow);
  }

  /* ---------- Image ---------- */
  .card-image {
    position: relative;
    height: 200px;
    overflow: hidden;
    background: #060c18;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
    transition: transform 0.5s ease;
    filter: brightness(0.85) saturate(0.9);
  }

  .proj-card:hover .card-image img {
    transform: scale(1.04);
    filter: brightness(1) saturate(1);
  }

  .card-image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 40%, #0d1524 100%);
    pointer-events: none;
  }

  /* Category badge */
  .category-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 4px 10px;
    background: var(--accent-bg);
    color: var(--accent);
    border: 1px solid var(--accent-border);
    border-radius: 99px;
    backdrop-filter: blur(8px);
  }

  /* Hover arrow overlay */
  .image-hover-link {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0);
    color: transparent;
    transition: background 0.3s, color 0.3s;
    z-index: 2;
  }

  .proj-card:hover .image-hover-link {
    background: rgba(0, 0, 0, 0.30);
    color: rgba(255, 255, 255, 0.90);
  }

  .image-hover-link svg {
    width: 28px;
    height: 28px;
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 0.3s, transform 0.3s;
  }

  .proj-card:hover .image-hover-link svg {
    opacity: 1;
    transform: scale(1);
  }

  /* ---------- Body ---------- */
  .card-body {
    padding: 1.25rem 1.25rem 0.75rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .card-title {
    font-size: 15px;
    font-weight: 600;
    color: #f1f5f9;
    line-height: 1.35;
    margin: 0;
    transition: color 0.2s;
  }

  .proj-card:hover .card-title {
    color: #ffffff;
  }

  .card-desc {
    font-size: 13px;
    line-height: 1.6;
    color: rgba(226, 232, 240, 0.50);
    margin: 0;
  }

  /* Tags */
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
  }

  .tag {
    font-size: 11px;
    font-weight: 500;
    padding: 3px 9px;
    background: rgba(255, 255, 255, 0.05);
    color: rgba(226, 232, 240, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 99px;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }

  .proj-card:hover .tag {
    background: var(--accent-bg);
    color: var(--accent);
    border-color: var(--accent-border);
  }

  /* ---------- Footer ---------- */
  .card-footer {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0.85rem 1.25rem 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    margin-top: 0.75rem;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12.5px;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s, gap 0.2s;
  }

  .card-link--primary {
    color: var(--accent);
  }
  .card-link--primary:hover { gap: 8px; }

  .card-link--secondary {
    color: rgba(226, 232, 240, 0.40);
  }
  .card-link--secondary:hover {
    color: rgba(226, 232, 240, 0.75);
  }

  /* ---------- Glow border top accent ---------- */
  .card-glow-border {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--accent);
    opacity: 0;
    transition: opacity 0.35s ease;
    border-radius: 16px 16px 0 0;
  }

  .proj-card:hover .card-glow-border {
    opacity: 1;
  }
</style>
