---
import { site, stats } from '../data/site';

const accentMap: Record<string, string> = {
  blue: '#38bdf8',
  amber: '#f59e0b',
  green: '#22c55e',
  purple: '#a855f7',
};
---
<section id="top" class="hero">
  <canvas id="hero-canvas" class="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-glow hero-glow--1" aria-hidden="true"></div>
  <div class="hero-glow hero-glow--2" aria-hidden="true"></div>

  <div class="hero-inner">
    <div class="hero-content">
      <div class="hero-eyebrow" data-animate="fade-up" data-delay="0">
        <span class="eyebrow-line" aria-hidden="true"></span>
        <span>Freelance Data Analyst</span>
        <span class="eyebrow-dot" aria-hidden="true"></span>
        <span class="eyebrow-status">Open to work</span>
      </div>

      <h1 class="hero-headline" data-animate="fade-up" data-delay="80">
        I turn messy records into<br />
        <span class="headline-typed" id="typed-phrase">decision-ready systems.</span>
      </h1>

      <p class="hero-sub" data-animate="fade-up" data-delay="160">
        I clean, audit, and structure business data so reports, dashboards,
        and workflows become reliable enough for real decisions.
      </p>

      <div class="hero-ctas" data-animate="fade-up" data-delay="240">
        <a href="#projects" class="cta-primary">
          View Projects
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2.5 7H11.5M7.5 3L11.5 7L7.5 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href={site.resumeUrl} class="cta-secondary" target="_blank" rel="noreferrer">Download Resume</a>
      </div>

      <div class="hero-stats" data-animate="fade-up" data-delay="320">
        {stats.map((item) => (
          <div class="stat-counter-card" style={`--card-accent:${accentMap[item.accent]};`}>
            <span class="count-num" data-count={item.value.replace(/[^0-9.]/g, '')} data-prefix={item.value.startsWith('₱') ? '₱' : item.value.startsWith('$') ? '$' : ''} data-suffix={item.value.includes('M+') ? 'M+' : item.value.includes('%') ? '%' : '+'}>{item.value}</span>
            <span class="count-label">{item.label}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="hero-image-wrap" data-animate="fade-left" data-delay="200">
      <div class="image-ring image-ring--outer" aria-hidden="true"></div>
      <div class="image-ring image-ring--inner" aria-hidden="true"></div>
      <div class="image-frame">
        <img src={site.profileImage} alt={site.name} class="hero-profile-img" width="320" height="320" loading="eager" />
      </div>
      <div class="profile-badge" aria-hidden="true">
        <span class="badge-dot"></span>
        <span>Available for hire</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 68px;
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0.55;
  }
  .hero-glow {
    position: absolute;
    pointer-events: none;
    border-radius: 50%;
    filter: blur(90px);
  }
  .hero-glow--1 {
    width: 600px;
    height: 600px;
    top: -120px;
    left: -160px;
    background: radial-gradient(circle, rgba(56,189,248,0.08) 0%, transparent 70%);
  }
  .hero-glow--2 {
    width: 500px;
    height: 500px;
    bottom: -80px;
    right: -100px;
    background: radial-gradient(circle, rgba(99,102,241,0.06) 0%, transparent 70%);
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    max-width: 1100px;
    width: 100%;
    margin: 0 auto;
    padding: 4rem 1.5rem 3rem;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4rem;
    align-items: center;
  }
  .hero-content { min-width: 0; }
  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.10em;
    color: #38bdf8;
    margin-bottom: 1.25rem;
  }
  .eyebrow-line { width: 32px; height: 1px; background: #38bdf8; display:block; }
  .eyebrow-dot { width: 4px; height: 4px; background: rgba(56,189,248,0.45); border-radius: 50%; }
  .eyebrow-status { color: rgba(56,189,248,0.65); font-size: 11px; }
  .hero-headline {
    font-size: clamp(34px, 5vw, 72px);
    font-weight: 700;
    line-height: 1.06;
    color: #f1f5f9;
    margin: 0 0 1.25rem;
    letter-spacing: -0.04em;
    max-width: 760px;
  }
  .headline-typed {
    color: #38bdf8;
    border-right: 2.5px solid #38bdf8;
    padding-right: 3px;
    animation: blink-cursor 1.1s step-end infinite;
  }
  @keyframes blink-cursor { 0%,100%{border-color:#38bdf8;} 50%{border-color:transparent;} }
  .hero-sub {
    font-size: 18px;
    line-height: 1.75;
    color: rgba(226, 232, 240, 0.60);
    max-width: 560px;
    margin: 0 0 2rem;
  }
  .hero-ctas {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 2.2rem;
  }
  .cta-primary, .cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 12px 24px;
    font-size: 15px;
    font-weight: 600;
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .cta-primary { background: #38bdf8; color: #08111d; border: 1px solid transparent; }
  .cta-primary:hover { background: #7dd3fc; transform: translateY(-2px); box-shadow: 0 8px 28px rgba(56, 189, 248, 0.35); }
  .cta-secondary { background: transparent; color: rgba(226, 232, 240, 0.80); border: 1px solid rgba(226, 232, 240, 0.18); }
  .cta-secondary:hover { border-color: rgba(226, 232, 240, 0.40); color: #f1f5f9; transform: translateY(-2px); }
  .hero-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    max-width: 760px;
  }
  .stat-counter-card {
    min-width: 0;
    border-radius: 16px;
    padding: 1.2rem 1rem;
    background: rgba(13,21,36,0.84);
    backdrop-filter: blur(12px);
  }
  .count-num {
    font-size: clamp(26px, 2.8vw, 34px);
    font-weight: 700;
    letter-spacing: -0.04em;
  }
  .count-label {
    margin-top: 0.55rem;
    display: block;
    font-size: 12px;
    color: rgba(226, 232, 240, 0.54);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .hero-image-wrap { position: relative; width: 320px; height: 320px; flex-shrink: 0; }
  .image-ring { position: absolute; inset: -12px; border-radius: 50%; border: 1px solid rgba(56, 189, 248, 0.16); animation: ring-pulse 4s ease-in-out infinite; }
  .image-ring--inner { inset: -28px; animation-delay: 1s; border-color: rgba(56, 189, 248, 0.1); }
  @keyframes ring-pulse { 0%,100% { transform: scale(1); opacity: .7; } 50% { transform: scale(1.035); opacity: 1; } }
  .image-frame {
    width: 100%; height: 100%; overflow: hidden; border-radius: 50%; position: relative;
    background: linear-gradient(180deg, rgba(255,255,255,0.9), rgba(255,255,255,0.9));
    border: 2px solid rgba(56,189,248,0.25);
    box-shadow: 0 20px 60px rgba(0,0,0,0.35);
  }
  .hero-profile-img { width: 100%; height: 100%; object-fit: cover; }
  .profile-badge {
    position: absolute; right: -18px; bottom: 28px; display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 16px; border-radius: 999px; background: rgba(10, 15, 28, 0.92); border: 1px solid rgba(56, 189, 248, 0.18);
    box-shadow: 0 8px 30px rgba(0,0,0,0.30); color: rgba(226,232,240,0.86); font-size: 15px;
  }
  .badge-dot { width: 10px; height: 10px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 12px rgba(34,197,94,0.6); }
  @media (max-width: 980px) {
    .hero-inner { grid-template-columns: 1fr; gap: 2.5rem; text-align: left; }
    .hero-image-wrap { order: -1; margin: 0 auto; width: 260px; height: 260px; }
    .profile-badge { right: 0; }
    .hero-headline { max-width: none; }
    .hero-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .hero-inner { padding: 3.25rem 1rem 2.5rem; }
    .hero-sub { font-size: 16px; }
    .hero-stats { grid-template-columns: 1fr; }
    .hero-image-wrap { width: 220px; height: 220px; }
    .profile-badge { position: static; margin-top: 1rem; width: fit-content; }
  }
</style>

<script lang="ts">
  (() => {
    const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
    const heroSection = document.getElementById('top');
    if (!canvas || !heroSection) return;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (prefersReducedMotion.matches) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    type Particle = { x:number; y:number; vx:number; vy:number; r:number };
    let width = 0; let height = 0; let animationId = 0; let running = false; let particles: Particle[] = [];
    const PARTICLE_COUNT = 48; const MAX_DISTANCE = 145; const COLOR = '56, 189, 248';

    const resizeCanvas = () => { width = canvas.offsetWidth; height = canvas.offsetHeight; canvas.width = width; canvas.height = height; };
    const createParticles = () => {
      particles = Array.from({ length: PARTICLE_COUNT }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.35,
        vy: (Math.random() - 0.5) * 0.35,
        r: Math.random() * 2 + 1,
      }));
    };
    const draw = () => {
      if (!running) return;
      ctx.clearRect(0, 0, width, height);
      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const dx = particles[i].x - particles[j].x; const dy = particles[i].y - particles[j].y; const d = Math.sqrt(dx*dx + dy*dy);
          if (d < MAX_DISTANCE) {
            ctx.beginPath();
            ctx.strokeStyle = `rgba(${COLOR}, ${(1 - d / MAX_DISTANCE) * 0.20})`;
            ctx.lineWidth = 0.8;
            ctx.moveTo(particles[i].x, particles[i].y); ctx.lineTo(particles[j].x, particles[j].y); ctx.stroke();
          }
        }
      }
      particles.forEach((p) => {
        ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2); ctx.fillStyle = `rgba(${COLOR}, 0.45)`; ctx.fill();
        p.x += p.vx; p.y += p.vy;
        if (p.x < 0 || p.x > width) p.vx *= -1;
        if (p.y < 0 || p.y > height) p.vy *= -1;
      });
      animationId = requestAnimationFrame(draw);
    };
    const start = () => { if (running) return; running = true; draw(); };
    const stop = () => { running = false; cancelAnimationFrame(animationId); };
    const visibilityObserver = new IntersectionObserver(([entry]) => entry.isIntersecting && !document.hidden ? start() : stop(), { threshold: 0.05 });
    const onVisibilityChange = () => {
      if (document.hidden) stop(); else {
        const rect = heroSection.getBoundingClientRect();
        const visible = rect.bottom > 0 && rect.top < window.innerHeight;
        if (visible) start();
      }
    };
    resizeCanvas(); createParticles(); visibilityObserver.observe(heroSection);
    window.addEventListener('resize', resizeCanvas, { passive: true });
    document.addEventListener('visibilitychange', onVisibilityChange, { passive: true });
  })();

  (() => {
    const typedEl = document.getElementById('typed-phrase');
    if (!typedEl) return;
    const phrases = ['decision-ready systems.', 'clean data pipelines.', 'audit-ready reports.', 'reliable dashboards.'];
    let phraseIndex = 0; let charIndex = 0; let deleting = false;
    const tick = () => {
      const currentPhrase = phrases[phraseIndex];
      if (!deleting) {
        charIndex++; typedEl.textContent = currentPhrase.slice(0, charIndex);
        if (charIndex === currentPhrase.length) { deleting = true; setTimeout(tick, 2200); return; }
        setTimeout(tick, 55);
      } else {
        charIndex--; typedEl.textContent = currentPhrase.slice(0, charIndex);
        if (charIndex === 0) { deleting = false; phraseIndex = (phraseIndex + 1) % phrases.length; setTimeout(tick, 320); return; }
        setTimeout(tick, 28);
      }
    };
    setTimeout(tick, 1200);
  })();
</script>
