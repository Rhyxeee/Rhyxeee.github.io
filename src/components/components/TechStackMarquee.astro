---
import { marqueeRows } from '../data/site';
---
<section class="marquee-section" aria-labelledby="toolbelt-title">
  <div class="marquee-shell">
    <div class="marquee-header" data-animate="fade-up">
      <span class="section-eyebrow">Toolbelt</span>
      <h2 id="toolbelt-title" class="section-title">Tools that keep moving with the work.</h2>
      <p class="section-sub">A cleaner, app-like skill presentation inspired by analytics products instead of résumé walls.</p>
    </div>

    <div class="marquee-board" data-animate="fade-up" data-delay="80">
      {marqueeRows.map((row, index) => (
        <div class={`marquee-row ${index % 2 === 1 ? 'reverse' : ''}`}>
          <div class="marquee-track">
            {[...row, ...row].map((item) => (
              <span class="marquee-pill">{item}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .marquee-section { padding: 2rem 1.5rem 6.5rem; }
  .marquee-shell { max-width: 1100px; margin: 0 auto; }
  .marquee-header { max-width: 720px; margin-bottom: 1.5rem; }
  .section-eyebrow { display:inline-flex; align-items:center; gap:.5rem; font-size:12px; font-weight:600; letter-spacing:.12em; text-transform:uppercase; color:#38bdf8; margin-bottom:1rem; }
  .section-eyebrow::before { content:""; width:26px; height:1px; background:rgba(56,189,248,.75); display:inline-block; }
  .section-title { margin:0 0 .85rem; font-size:clamp(28px,3.4vw,40px); line-height:1.12; letter-spacing:-.03em; color:#f8fafc; font-weight:650; }
  .section-sub { margin:0; font-size:16px; line-height:1.75; color:rgba(226,232,240,.6); }
  .marquee-board {
    border-radius: 24px;
    padding: 1rem;
    border: 1px solid rgba(255,255,255,.08);
    background: linear-gradient(180deg, rgba(17,24,39,.76), rgba(10,15,28,.92));
    box-shadow: 0 20px 60px rgba(0,0,0,.22);
    overflow: hidden;
    position: relative;
  }
  .marquee-board::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(56,189,248,.3), transparent);
  }
  .marquee-row { overflow: hidden; margin: .55rem 0; mask-image: linear-gradient(90deg, transparent, black 10%, black 90%, transparent); }
  .marquee-track { display:flex; width:max-content; gap:.8rem; animation: marquee-left 34s linear infinite; }
  .marquee-row.reverse .marquee-track { animation-name: marquee-right; animation-duration: 38s; }
  .marquee-pill {
    flex: 0 0 auto;
    display:inline-flex; align-items:center; padding:.72rem 1rem;
    border-radius:999px; font-size:13.5px; font-weight:500; letter-spacing:.01em;
    color:rgba(226,232,240,.9); background:rgba(15,23,42,.85); border:1px solid rgba(255,255,255,.08);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.02);
  }
  .marquee-row:nth-child(1) .marquee-pill:nth-child(4n+1) { border-color: rgba(56,189,248,.24); color:#7dd3fc; }
  .marquee-row:nth-child(2) .marquee-pill:nth-child(4n+1) { border-color: rgba(245,158,11,.24); color:#fbbf24; }
  .marquee-row:nth-child(3) .marquee-pill:nth-child(4n+1) { border-color: rgba(168,85,247,.24); color:#c084fc; }
  @keyframes marquee-left { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @keyframes marquee-right { from { transform: translateX(-50%); } to { transform: translateX(0); } }
  @media (max-width: 640px) {
    .marquee-section { padding: 1.5rem 1rem 5rem; }
    .marquee-board { padding: .75rem; border-radius: 20px; }
    .marquee-track { gap: .6rem; }
    .marquee-pill { font-size: 12.5px; padding: .62rem .88rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none !important; }
  }
</style>
