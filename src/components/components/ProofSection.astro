---
import { proofCards } from '../data/site';

const accentMap: Record<string, string> = {
  blue: '#38bdf8',
  amber: '#f59e0b',
  green: '#22c55e',
  purple: '#a855f7',
};
---
<section id="proof" class="proof-section">
  <div class="proof-shell">
    <div class="proof-intro" data-animate="fade-up">
      <span class="section-eyebrow">Proof & Focus</span>
      <h2 class="section-title">Signals that make the portfolio more than a visual shell.</h2>
      <p class="section-sub">A cleaner version of the certifications-style area, adapted to your real education, current work, and analytics direction.</p>
    </div>

    <div class="proof-grid" data-stagger-parent="90">
      {proofCards.map((item) => (
        <article class="proof-card" data-animate="fade-up" style={`--accent:${accentMap[item.accent]};`}>
          <span class="proof-meta">{item.meta}</span>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .proof-section { padding: 6.5rem 1.5rem 7rem; }
  .proof-shell { max-width: 1100px; margin: 0 auto; }
  .proof-intro { max-width: 760px; margin-bottom: 2.2rem; }
  .section-eyebrow { display:inline-flex; align-items:center; gap:.5rem; font-size:12px; font-weight:600; letter-spacing:.12em; text-transform:uppercase; color:#38bdf8; margin-bottom:1rem; }
  .section-eyebrow::before { content:""; width:26px; height:1px; background:rgba(56,189,248,.75); display:inline-block; }
  .section-title { margin:0 0 1rem; font-size:clamp(28px,3.4vw,40px); line-height:1.12; letter-spacing:-.03em; color:#f8fafc; font-weight:650; }
  .section-sub { margin:0; font-size:16px; line-height:1.75; color:rgba(226,232,240,.62); max-width:720px; }
  .proof-grid { display:grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap:1rem; }
  .proof-card {
    border-radius: 22px;
    padding: 1.25rem;
    background: linear-gradient(180deg, rgba(17,24,39,.8), rgba(10,15,28,.94));
    border: 1px solid rgba(255,255,255,.08);
    box-shadow: 0 18px 46px rgba(0,0,0,.18);
    position: relative;
    overflow: hidden;
  }
  .proof-card::before { content:""; position:absolute; inset:0 0 auto 0; height:2px; background: var(--accent); opacity:.9; }
  .proof-meta { display:inline-flex; margin-bottom:.8rem; padding:.42rem .75rem; border-radius:999px; background:color-mix(in srgb, var(--accent) 12%, transparent); border:1px solid color-mix(in srgb, var(--accent) 28%, transparent); color:var(--accent); font-size:12px; font-weight:600; letter-spacing:.04em; }
  .proof-card h3 { margin:0 0 .7rem; font-size:1.12rem; line-height:1.25; letter-spacing:-.02em; }
  .proof-card p { margin:0; color:rgba(226,232,240,.7); font-size:14px; line-height:1.75; }
  @media (max-width: 980px) { .proof-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .proof-section { padding:5rem 1rem 5.5rem; } .proof-grid { grid-template-columns: 1fr; } }
</style>
