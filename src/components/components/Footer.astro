---
import { site } from '../data/site';
---
<footer class="site-footer">
  <div class="footer-shell">
    <p class="footer-copy">© 2026 {site.name}. Built with Astro and a dashboard-inspired design system.</p>
    <div class="footer-links">
      {site.socialLinks.map((item) => (
        <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel="noreferrer" class="footer-link">{item.label}</a>
      ))}
    </div>
  </div>
</footer>

<style>
  .site-footer { padding: 0 1.5rem 2.5rem; }
  .footer-shell { max-width: 1100px; margin: 0 auto; padding-top: 1.6rem; border-top: 1px solid rgba(255,255,255,.08); display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap; }
  .footer-copy { margin:0; color:rgba(226,232,240,.45); font-size:14px; line-height:1.7; }
  .footer-links { display:flex; flex-wrap:wrap; gap:1rem; }
  .footer-link { color:rgba(226,232,240,.6); text-decoration:none; font-size:14px; transition:color .2s ease; }
  .footer-link:hover { color:#f8fafc; }
  @media (max-width: 640px) { .site-footer { padding:0 1rem 2rem; } .footer-shell { align-items:flex-start; flex-direction:column; } }
</style>
