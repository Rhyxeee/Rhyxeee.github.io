---
interface LinkItem {
  label: string;
  href: string;
}
interface Props {
  title: string;
  category: string;
  accent?: 'blue' | 'amber' | 'green' | 'purple';
  description: string;
  imageSrc: string;
  imageAlt: string;
  tags?: string[];
  href: string;
  links?: LinkItem[];
}
const { title, category, accent = 'blue', description, imageSrc, imageAlt, tags = [], href, links = [] } = Astro.props;
const accentMap = {
  blue: { color: 'var(--blue)', border: 'rgba(56,189,248,0.28)' },
  amber: { color: 'var(--amber)', border: 'rgba(245,158,11,0.28)' },
  green: { color: 'var(--green)', border: 'rgba(34,197,94,0.28)' },
  purple: { color: 'var(--purple)', border: 'rgba(168,85,247,0.28)' }
}[accent];
---

<article class="project-card panel" style={`--accent:${accentMap.color}; --accent-border:${accentMap.border};`}>
  <a href={href} class="project-media-wrap">
    <img class="project-media" src={imageSrc} alt={imageAlt} loading="lazy" />
    <span class="project-badge">{category}</span>
  </a>
  <div class="project-body">
    <h3><a href={href}>{title}</a></h3>
    <p>{description}</p>
    <div class="project-tags">
      {tags.map((tag) => (
        <span class="tag">{tag}</span>
      ))}
    </div>
  </div>
  <div class="project-footer">
    <a href={href} class="project-link project-link--primary">View case study →</a>
    {links.slice(0, 1).map((item) => (
      <a href={item.href} target="_blank" rel="noreferrer" class="project-link">{item.label}</a>
    ))}
  </div>
</article>

<style>
  .project-card {
    display: grid;
    min-height: 100%;
    border-color: var(--accent-border);
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  }
  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 66px rgba(0,0,0,0.3);
  }
  .project-media-wrap {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border-soft);
    text-decoration: none;
  }
  .project-media {
    width: 100%;
    aspect-ratio: 16/10;
    object-fit: cover;
    transition: transform 0.35s ease;
    background: #08101f;
  }
  .project-card:hover .project-media { transform: scale(1.03); }
  .project-badge {
    position: absolute;
    left: 1rem;
    top: 1rem;
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 0.55rem 0.9rem;
    background: rgba(7, 12, 24, 0.86);
    border: 1px solid var(--accent-border);
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .project-body { padding: 1.2rem 1.2rem 0.85rem; }
  .project-body h3 { margin: 0 0 0.8rem; font-size: 1.55rem; line-height: 1.18; letter-spacing: -0.03em; }
  .project-body h3 a { text-decoration: none; }
  .project-body p { margin: 0; color: var(--muted); line-height: 1.8; }
  .project-tags { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1rem; }
  .project-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 1rem 1.2rem 1.2rem;
    border-top: 1px solid var(--border-soft);
  }
  .project-link {
    text-decoration: none;
    color: var(--muted);
    font-weight: 600;
  }
  .project-link:hover { color: var(--text); }
  .project-link--primary { color: var(--accent); }
</style>
