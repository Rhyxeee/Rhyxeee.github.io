---
import { site, stats } from '../data/site';

const accentMap: Record<string, string> = {
  blue: 'var(--blue)',
  amber: 'var(--amber)',
  green: 'var(--green)',
  purple: 'var(--purple)'
};
---

<section class="hero-home page-shell">
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow">Data Manager · Analytics and Reporting</span>
      <h1 class="display-title">I turn messy records into <span class="accent-blue">decision-ready systems.</span></h1>
      <p class="lead">
        I clean, audit, and structure business data so dashboards, reports, and workflows stay
        reliable, usable, and ready for real decisions.
      </p>
      <div class="hero-actions">
        <a href="/projects" class="btn">View Projects</a>
        <a href={site.resumeUrl} target="_blank" rel="noreferrer" class="btn-ghost">Download Resume</a>
      </div>
      <div class="stats-grid">
        {stats.map((item) => (
          <div class="stat-card card" style={`--accent:${accentMap[item.accent]};`}>
            <span class="stat-value">{item.value}</span>
            <span class="stat-label">{item.label}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="hero-side panel panel-pad-lg">
      <div class="hero-avatar-wrap">
        <div class="avatar-ring"></div>
        <img src={site.profileImage} alt={site.name} class="hero-avatar" width="320" height="320" />
      </div>
      <div class="hero-side-copy">
        <span class="pill accent-border-blue">Currently at GSH Investments</span>
        <h2>{site.name}</h2>
        <p>
          Data manager focused on data cleaning, reporting systems, analytics support, and
          audit-ready workflow design.
        </p>
        <div class="hero-mini-grid">
          <div class="mini-card card">
            <strong>Primary focus</strong>
            <span>Data cleaning, reporting workflows, operational QA, and decision-ready outputs.</span>
          </div>
          <div class="mini-card card">
            <strong>Working style</strong>
            <span>Clear logic, clean handoff, practical reporting, and outputs that hold up under review.</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-home {
    padding-top: 5.2rem;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(340px, 0.92fr);
    gap: 1.35rem;
    align-items: start;
  }
  .hero-copy { padding-top: 0.35rem; }
  .hero-actions { display: flex; gap: 0.85rem; flex-wrap: wrap; margin: 1.75rem 0 1.9rem; }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.85rem;
    margin-top: 0.2rem;
  }
  .stat-card {
    padding: 0.95rem 0.95rem 0.9rem;
    border-color: color-mix(in srgb, var(--accent) 28%, rgba(255,255,255,0.08));
    position: relative;
    overflow: hidden;
  }
  .stat-card::before {
    content: "";
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 3px;
    background: var(--accent);
  }
  .stat-value {
    display: block;
    font-size: clamp(1.75rem, 2vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    margin-bottom: 0.18rem;
  }
  .stat-label { color: var(--muted-2); font-size: 0.92rem; }
  .hero-side {
    display: grid;
    gap: 0.8rem;
    align-content: start;
    max-width: 560px;
    width: 100%;
    margin-left: auto;
    padding: 1.45rem;
  }
  .hero-avatar-wrap { position: relative; width: min(100%, 280px); margin: 0 auto; }
  .avatar-ring {
    position: absolute;
    inset: -12px;
    border-radius: 50%;
    border: 1px solid rgba(56,189,248,0.18);
    box-shadow: 0 0 0 12px rgba(56,189,248,0.04), 0 0 0 22px rgba(56,189,248,0.02);
  }
  .hero-avatar {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    border: 3px solid rgba(56,189,248,0.34);
    background: #d4d4d8;
  }
  .hero-side-copy h2 {
    margin: 0.55rem 0 0.35rem;
    font-size: 1.7rem;
    line-height: 1.08;
    letter-spacing: -0.03em;
  }
  .hero-side-copy p {
    margin: 0;
    color: var(--muted);
    line-height: 1.68;
    font-size: 0.98rem;
  }
  .hero-mini-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 0.85rem;
  }
  .mini-card { padding: 0.85rem 0.9rem; display: grid; gap: 0.28rem; }
  .mini-card strong { font-size: 0.96rem; }
  .mini-card span { color: var(--muted); line-height: 1.58; font-size: 0.92rem; }
  @media (max-width: 1024px) {
    .hero-home { padding-top: 4.4rem; }
    .hero-grid { grid-template-columns: 1fr; gap: 1.1rem; }
    .hero-side { margin-left: 0; max-width: none; }
  }
  @media (max-width: 720px) {
    .hero-home { padding-top: 3.7rem; }
    .stats-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hero-mini-grid { grid-template-columns: 1fr; }
    .hero-avatar-wrap { width: min(100%, 240px); }
  }
</style>
