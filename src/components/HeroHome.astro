---
import { site, stats } from '../data/site';

const accentMap: Record<string, string> = {
  blue: 'var(--blue)',
  amber: 'var(--amber)',
  green: 'var(--green)',
  purple: 'var(--purple)'
};
---

<section class="hero-home page-shell">
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow">Freelance Data Analyst · Open to work</span>
      <h1 class="display-title">I turn messy records into <span class="accent-blue">decision-ready systems.</span></h1>
      <p class="lead">
        I clean, audit, and structure business data so dashboards, reports, and workflows become usable,
        reliable, and easier to trust.
      </p>
      <div class="hero-actions">
        <a href="/projects" class="btn">View Projects</a>
        <a href={site.resumeUrl} target="_blank" rel="noreferrer" class="btn-ghost">Download Resume</a>
      </div>
      <div class="stats-grid">
        {stats.map((item) => (
          <div class="stat-card card" style={`--accent:${accentMap[item.accent]};`}>
            <span class="stat-value">{item.value}</span>
            <span class="stat-label">{item.label}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="hero-side panel panel-pad-lg">
      <div class="hero-avatar-wrap">
        <div class="avatar-ring"></div>
        <img src={site.profileImage} alt={site.name} class="hero-avatar" width="360" height="360" />
      </div>
      <div class="hero-side-copy">
        <span class="pill accent-border-blue">Available for work</span>
        <h2>{site.name}</h2>
        <p>{site.role} focused on data cleaning, analytics, reporting, and audit-ready workflow design.</p>
        <div class="hero-mini-grid">
          <div class="mini-card card">
            <strong>Primary focus</strong>
            <span>Data cleaning, reporting systems, operational QA, portfolio-ready analysis.</span>
          </div>
          <div class="mini-card card">
            <strong>Working style</strong>
            <span>Accuracy first. Clear documentation. Repeatable systems. Practical outputs.</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: 1.5rem;
    align-items: stretch;
  }
  .hero-copy { padding-top: 1rem; }
  .hero-actions { display: flex; gap: 0.85rem; flex-wrap: wrap; margin: 2rem 0; }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.9rem;
    margin-top: 1rem;
  }
  .stat-card {
    padding: 1rem 1rem 0.95rem;
    border-color: color-mix(in srgb, var(--accent) 28%, rgba(255,255,255,0.08));
    position: relative;
    overflow: hidden;
  }
  .stat-card::before {
    content: "";
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 3px;
    background: var(--accent);
  }
  .stat-value { display: block; font-size: 2rem; font-weight: 700; letter-spacing: -0.04em; margin-bottom: 0.25rem; }
  .stat-label { color: var(--muted-2); font-size: 0.95rem; }
  .hero-side { display: grid; gap: 1.2rem; align-content: start; }
  .hero-avatar-wrap { position: relative; width: min(100%, 360px); margin: 0 auto; }
  .avatar-ring {
    position: absolute;
    inset: -12px;
    border-radius: 50%;
    border: 1px solid rgba(56,189,248,0.18);
    box-shadow: 0 0 0 12px rgba(56,189,248,0.04), 0 0 0 22px rgba(56,189,248,0.02);
  }
  .hero-avatar {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    border: 3px solid rgba(56,189,248,0.34);
    background: #d4d4d8;
  }
  .hero-side-copy h2 { margin: 0.75rem 0 0.45rem; font-size: 1.75rem; }
  .hero-side-copy p { margin: 0; color: var(--muted); line-height: 1.8; }
  .hero-mini-grid { display: grid; gap: 0.9rem; margin-top: 1rem; }
  .mini-card { padding: 1rem; display: grid; gap: 0.35rem; }
  .mini-card strong { font-size: 0.98rem; }
  .mini-card span { color: var(--muted); line-height: 1.7; }
  @media (max-width: 1024px) {
    .hero-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 720px) {
    .stats-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
