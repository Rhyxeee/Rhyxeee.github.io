---
import { site } from '../data/site';
const { currentPath = '/' } = Astro.props;
---

<header class="site-header">
  <div class="container nav-wrap">
    <a href="/" class="brand" aria-label="Home">
      <span class="brand-mark">MN</span>
      <span class="brand-copy">
        <span class="brand-name">{site.name}</span>
        <span class="brand-role">{site.role}</span>
      </span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      {site.nav.map((item) => (
        <a href={item.href} class:list={["nav-link", currentPath === item.href && 'is-active']}>
          {item.label}
        </a>
      ))}
      <a href={site.resumeUrl} target="_blank" rel="noreferrer" class="resume-link">Resume</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: rgba(5, 9, 20, 0.8);
    backdrop-filter: blur(16px) saturate(145%);
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .nav-wrap {
    min-height: 78px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.15rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.95rem;
    text-decoration: none;
  }
  .brand-mark {
    width: 46px;
    height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 15px;
    color: var(--blue);
    border: 1px solid rgba(56,189,248,0.26);
    background: rgba(56,189,248,0.1);
    font-weight: 700;
    letter-spacing: 0.08em;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.03);
  }
  .brand-copy { display: grid; gap: 0.14rem; }
  .brand-name { font-weight: 650; }
  .brand-role { color: var(--muted-2); font-size: 0.82rem; }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .nav-link, .resume-link {
    text-decoration: none;
    color: rgba(226,232,240,0.74);
    padding: 0.72rem 1rem;
    border-radius: 999px;
    font-size: 0.95rem;
    transition: all 0.22s ease;
    border: 1px solid transparent;
  }
  .nav-link:hover, .resume-link:hover {
    color: var(--text);
    background: rgba(255,255,255,0.04);
  }
  .nav-link.is-active {
    color: var(--blue);
    background: rgba(56,189,248,0.08);
    border-color: rgba(56,189,248,0.18);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.03);
  }
  .resume-link {
    color: var(--text);
    border-color: rgba(56,189,248,0.28);
  }
  @media (max-width: 880px) {
    .nav-wrap {
      padding-top: 0.95rem;
      padding-bottom: 0.95rem;
      align-items: flex-start;
      flex-direction: column;
    }
    .nav-links { width: 100%; }
  }
</style>
